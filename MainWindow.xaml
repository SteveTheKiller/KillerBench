                <Border Panel.ZIndex="20" IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                <Border Panel.ZIndex="20" IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}" BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                <Border Background="{DynamicResource PaneBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                  <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/></Border.Effect>
                </Border>
                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                <Border Background="Transparent" BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12,14,4">
                  <StackPanel>
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/><Grid Margin="0,1,0,0"><TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource UiFont}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="Hand" MouseLeftButtonUp="OnAboutRelease"/><TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" FontStyle="Italic" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></StackPanel>
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/><TextBlock x:Name="AboutPublisherBlock" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="{DynamicResource Str_About_Aka}"/><Run Text=" "/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="OnAboutLink" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock></StackPanel>
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/><TextBlock x:Name="AboutThumbprintBlock" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,0,10"><TextBlock Text="{DynamicResource Str_About_ExeHash}" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/><TextBlock x:Name="AboutSha256Block" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="NoWrap"/></StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Margin="0,14,0,0" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                <TextBlock Text="{DynamicResource Str_About_KillerMcp}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Str_About_KillerMcpNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <CheckBox x:Name="AgentSafeRepairsCheck" FontSize="11" Click="OnAgentRepairsChanged"><TextBlock Text="{DynamicResource Str_About_KillerMcpSafe}" TextWrapping="Wrap"/></CheckBox>
                <CheckBox x:Name="AgentDisruptiveRepairsCheck" FontSize="11" Margin="0,6,0,0" Click="OnAgentRepairsChanged"><TextBlock Text="{DynamicResource Str_About_KillerMcpDisruptive}" TextWrapping="Wrap"/></CheckBox>
                <TextBlock x:Name="AgentRepairLockBlock" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"><Run x:Name="AgentRepairLockRun"/><Run Text=" "/><Hyperlink Click="OnAgentRepairClearLock" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None"><Run Text="{DynamicResource Str_About_KillerMcpClearLock}"/></Hyperlink></TextBlock>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="ShortcutsOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Background="#B0000000" Visibility="Collapsed" MouseLeftButtonDown="OnShortcutsBackdrop">
      <Border x:Name="ShortcutCard" Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="430" MaxWidth="640" MouseLeftButtonDown="OnShortcutsCard">
        <Grid><Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
          <Border Padding="24">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Text_Keyboard_shortcuts}" FontSize="20" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"><Button x:Name="ShortcutListButton" Content="{DynamicResource Str_Shortcuts_List}" Click="OnShortcutList" Margin="0,0,6,0"/><Button x:Name="ShortcutMapButton" Content="{DynamicResource Str_Shortcuts_Keyboard}" Click="OnShortcutMap"/></StackPanel>
                <TextBlock Grid.Column="2" FontSize="11" MaxWidth="210" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,24,0">
                  <Hyperlink NavigateUri="https://killerbench.net/help/workspace.html#themes-languages-and-shortcuts" RequestNavigate="OnAboutLink" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None"><Run Text="{DynamicResource Str_KS_OnlineHelp}"/></Hyperlink>
                </TextBlock>
              </Grid>
              <ScrollViewer x:Name="ShortcutListScroll" MaxHeight="520" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ShortcutListHost"/></ScrollViewer>
              <StackPanel x:Name="ShortcutMapHost" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"><Button x:Name="ShortcutBaseButton" Content="{DynamicResource Str_Shortcuts_Base}" Click="OnShortcutBase" Margin="0,0,6,0"/><Button x:Name="ShortcutCtrlButton" Content="{DynamicResource Str_Shortcuts_Ctrl}" Click="OnShortcutCtrl"/></StackPanel>
                <StackPanel x:Name="ShortcutKeyboardRows"/>
              </StackPanel>
              <Button Content="{DynamicResource Str_Content_Close}" Click="OnShortcuts" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Border>
  </Grid>
  </Border>
</Window>
