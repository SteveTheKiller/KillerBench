<Window x:Class="KillerBench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerBench.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:workflows="clr-namespace:KillerBench.Engine.Workflows;assembly=KillerBench.Engine"
        xmlns:security="clr-namespace:KillerBench.Engine.Security;assembly=KillerBench.Engine"
        xmlns:bitlocker="clr-namespace:KillerBench.Engine.BitLocker;assembly=KillerBench.Engine"
        Title="KillerBench" Icon="Assets/AppIcon.ico" Width="1025" Height="700" MinWidth="800" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" SizeToContent="Manual" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="12"
        AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnDragOver" PreviewKeyDown="OnKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowEdgeBorder" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="{DynamicResource WindowEdgeThickness}">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Border x:Name="WorkspaceGrain" Grid.Row="1" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" IsHitTestVisible="False"/>
    <Grid x:Name="CaptionBar" Background="Transparent" Height="{DynamicResource TitleBarHeight}" MouseLeftButtonDown="OnCaptionDrag" Panel.ZIndex="1">
      <Border Background="{DynamicResource TitleBarBrush}" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}" IsHitTestVisible="False"/>
      <StackPanel x:Name="LogoBar" Orientation="Horizontal" Margin="{DynamicResource TitleLogoMargin}" VerticalAlignment="Center" PreviewMouseWheel="OnAppScale" ToolTip="{DynamicResource Str_ToolTip_Scroll_here_to_resize_the_interface}">
        <icons:AppIcon x:Name="TitlebarIcon" Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}" Margin="{DynamicResource TitleIconMargin}" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="KillerBench icon. Scroll to zoom the interface."/>
        <Grid Margin="0,-18,0,-22" VerticalAlignment="Center"><Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
          <TextBlock Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkShadowOpacity}" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Visibility="{DynamicResource WordmarkVisibility}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
          <TextBlock Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Visibility="{DynamicResource WordmarkVisibility}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
          <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Visibility="{DynamicResource WordmarkVisibility}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
        </Grid>
        <TextBlock Text="KillerBench" FontFamily="{DynamicResource ChromeFontFamily}" Foreground="{DynamicResource ChromeTextBrush}" FontWeight="Bold" Visibility="{DynamicResource PlainTitleVisibility}"/>
        <TextBlock Text="{DynamicResource Str_Text_DIAGNOSTIC_WORKBENCH}" FontFamily="{DynamicResource FileNameFont}" FontSize="{DynamicResource FileNameFontSize}" RenderTransform="{DynamicResource FileNameTransform}" TextOptions.TextFormattingMode="Ideal" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="{DynamicResource Str_ToolTip_Minimize}"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="{DynamicResource Str_ToolTip_Maximize_or_restore}"/>
        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="{DynamicResource Str_ToolTip_Close}"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="ZoomViewport" Grid.Row="1" ClipToBounds="True">
    <Grid x:Name="ScaleHost" Margin="4,4,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ActualWidth, ElementName=LeftPanel}"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="SidebarRail" Grid.Column="1" Panel.ZIndex="1">
        <Button x:Name="SidebarButton" Style="{StaticResource RailButton}" Content="&#xE76B;" FontSize="12" VerticalAlignment="Top" Margin="2,10,0,0" Click="OnToggleSources" ToolTip="{DynamicResource Str_ToolTip_Toggle_sources_F2}"/>
        <StackPanel Style="{StaticResource RailButtonHost}" VerticalAlignment="Bottom">
          <Button x:Name="ActivityButton" Style="{StaticResource RailButton}" Content="&#xE756;" Click="OnToggleActivity" ToolTip="{DynamicResource Str_ToolTip_Toggle_activity_log_F3}" Margin="0,0,0,6"/>
          <Button x:Name="ShortcutButton" Style="{StaticResource RailButton}" Content="?" FontFamily="Consolas" FontSize="18" Click="OnShortcuts" ToolTip="{DynamicResource Str_ToolTip_Keyboard_shortcuts_F1}" Margin="0,0,0,6"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock Text="?" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextBrush}" TextOptions.TextFormattingMode="Display" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template></Button>
          <Button x:Name="LangButton" Style="{StaticResource RailButton}" Content="&#xF2B7;" Click="OnLanguages" ContextMenuOpening="RailMenu_Opening" ToolTip="{DynamicResource Str_ToolTip_Language}" Margin="0,0,0,6"><Button.ContextMenu><ContextMenu/></Button.ContextMenu></Button>
<Button x:Name="ThemeButton" Style="{StaticResource RailButton}" Content="&#xE790;" Click="OnThemes" ContextMenuOpening="RailMenu_Opening" ToolTip="{DynamicResource Str_ToolTip_Choose_app_theme}" Margin="0,0,0,6"><Button.ContextMenu><ContextMenu x:Name="ThemeFlyout">
                                
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Grid>
                                            <Border Style="{StaticResource FlyoutCard}">
                                                <Grid>
                                                    <ItemsPresenter/>
                                                    <Border Style="{StaticResource FlyoutGrain}"/>
                                                </Grid>
                                            </Border>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border IsHitTestVisible="False" Margin="22,18,22,26"
                                                    BorderBrush="{DynamicResource BevelDarkBrush}"  BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource PanelMenuItem}"/>
                                </ContextMenu.ItemContainerStyle>
                                <Grid Margin="12,10,3,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                
                                <StackPanel x:Name="ThemeSubmenu" MinWidth="150" Grid.Column="0">
                                    <RadioButton x:Name="ThemeDarkRadio"
                                                 Content="{DynamicResource Str_Theme_Dark}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Dark" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeLightRadio"
                                                 Content="{DynamicResource Str_Theme_Light}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Light" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeHCRadio"
                                                 Content="{DynamicResource Str_Theme_Black}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Black" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="Theme98SERadio"
                                                 Content="{DynamicResource Str_Theme_SE98}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Retro98" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeBloodRadio"
                                                 Content="{DynamicResource Str_Theme_Blood}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Blood" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeGreedRadio"
                                                 Content="{DynamicResource Str_Theme_Greed}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Greed" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeCyanoticRadio"
                                                 Content="{DynamicResource Str_Theme_Cyanotic}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Cyanotic" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeEctoplasmRadio"
                                                 Content="{DynamicResource Str_Theme_Ectoplasm}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Ectoplasm" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeDecayRadio"
                                                 Content="{DynamicResource Str_Theme_Decay}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Decay" Checked="OnThemeSelected"/>
                                    
                                    <RadioButton x:Name="ThemeMalaiseRadio"
                                                 Content="{DynamicResource Str_Theme_Malaise}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Malaise" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeSepulchreRadio"
                                                 Content="{DynamicResource Str_Theme_Sepulchre}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Sepulchre" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeDeliriumRadio"
                                                 Content="{DynamicResource Str_Theme_Delirium}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Delirium" Checked="OnThemeSelected"/>
                                    <RadioButton x:Name="ThemeMourningRadio"
                                                 Content="{DynamicResource Str_Theme_Mourning}"
                                                 GroupName="ThemeGroup"
                                                 Style="{StaticResource ThemeRadio}"
                                                 Tag="Mourning" Checked="OnThemeSelected"/>

                                    
                                    
                                    
                                    
                                </StackPanel>
                                    <Grid x:Name="AccentStripHost" Grid.Column="1" Width="0" ClipToBounds="True">
                                        <Border Width="1" HorizontalAlignment="Left" Margin="0,6"
                                                Background="{DynamicResource MenuBorderBrush}"/>
                                        <Grid x:Name="AccentStrip" Margin="7,6,2,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="AccentStripDot0" Grid.Row="0" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot1" Grid.Row="1" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot2" Grid.Row="2" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot3" Grid.Row="3" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot4" Grid.Row="4" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot5" Grid.Row="5" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot6" Grid.Row="6" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="OnAccentSelected"/>
                                            <Border x:Name="AccentStripDot7" Grid.Row="7" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0" MouseLeftButtonUp="OnAccentSelected"/>
                                        </Grid>
                                    </Grid>
                                    <!-- Film Grain: one switch for the grain texture on every surface
                                         (Services/FilmGrain.cs). Its own row under both columns, so the
                                         accent strip still runs the height of the theme list only. -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <Border Height="1" Margin="0,0,9,8" Opacity="0.18" IsHitTestVisible="False"
                                                Background="{DynamicResource TextBrush}">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="Black" Offset="0.15"/>
                                                    <GradientStop Color="Black" Offset="0.85"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                        <CheckBox x:Name="FilmGrainCheck" Content="{DynamicResource Str_Theme_FilmGrain}"
                                                  Style="{StaticResource ThemeCheck}" Margin="0"
                                                  Click="OnFilmGrain"/>
                                    </StackPanel>
                                </Grid>
                            </ContextMenu></Button.ContextMenu></Button>
        </StackPanel>
      </Grid>
      <Thumb x:Name="SidebarGrip" Grid.Column="1" Style="{StaticResource SidebarResizeGrip}" HorizontalAlignment="Left" Margin="0,34,0,0" DragStarted="OnSidebarGripStarted" DragDelta="OnSidebarGripDelta" DragCompleted="OnSidebarGripCompleted"/>
      <Grid Grid.ColumnSpan="3" x:Name="ContentPane" UseLayoutRounding="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="2*" MinWidth="300"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="LeftPanel" Width="180" Grid.RowSpan="2" Background="{DynamicResource SidebarPaneBrush}" Margin="0" ClipToBounds="True">
<Grid>
<Border Padding="4,6,4,4"><DockPanel>
      <StackPanel x:Name="SidebarHeader" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SidebarHeading" Text="{DynamicResource Str_Shell_Tools}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource BrandSansFont}" FontSize="20" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <ListBox x:Name="CategoryList" Margin="0" Background="Transparent" BorderThickness="0" SelectionChanged="OnCategorySelected" AutomationProperties.Name="Tool categories" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SourceItem}">
          <!-- Family view-button semantics (KillerScan ViewToolbarButton / KillerPDF ToolbarButton): transparent at rest,
               RowHoverBrush on hover, and the theme's SelectionBg/SelectionFg pair marks the current section. -->
          <Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Padding" Value="9,3"/><Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="CategoryFace" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CategoryFace" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="CategoryFace" Property="Background" Value="{DynamicResource SelectionBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
      </ListBox>
        </DockPanel></Border></Grid>
</Border>
        <Grid x:Name="ConsoleBank" Grid.Column="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="ToolCard" Grid.Row="0" Style="{StaticResource Panel}" Margin="0">
<Grid><Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}" Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
<Border Padding="14">
          <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
              <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
              </Style>
            </ScrollViewer.Resources>
          <StackPanel>
            <TextBlock x:Name="CategoryTitle" Text="{DynamicResource Str_Shell_Diagnostics}" FontFamily="{DynamicResource BrandSansFont}" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock x:Name="CategoryDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,6">
              <ComboBox x:Name="MainWorkflow" ItemsSource="{x:Static workflows:WorkflowCatalog.All}" DisplayMemberPath="Title" SelectedIndex="0" Visibility="Collapsed" SelectionChanged="OnWorkflowOptionsChanged"/>
              <ComboBox x:Name="CategoryWorkflow" DisplayMemberPath="Title" Width="250" AutomationProperties.Name="Tool in selected category" Margin="0,0,8,0" SelectionChanged="OnCategoryWorkflowSelected"/>
            </WrapPanel>
            <StackPanel x:Name="ServicingMonitorSettings" Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="{DynamicResource Str_Peek_Description}" TextWrapping="Wrap"/>
              <TextBlock Margin="0,6,0,0"><Run Text="{DynamicResource Str_Peek_RefreshPrefix}"/><Run Text="{Binding ElementName=ServicingMonitorRefresh, Path=Value, StringFormat={}{0:0}}"/><Run Text="{DynamicResource Str_Peek_SecondsSuffix}"/></TextBlock>
              <Slider x:Name="ServicingMonitorRefresh" Minimum="1" Maximum="60" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
              <TextBlock Margin="0,6,0,0"><Run Text="{DynamicResource Str_Peek_SnapshotsPrefix}"/><Run Text="{Binding ElementName=ServicingMonitorSamples, Path=Value, StringFormat={}{0:0}}"/></TextBlock>
              <Slider x:Name="ServicingMonitorSamples" Minimum="1" Maximum="120" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
              <CheckBox x:Name="ServicingMonitorEvents" Content="{DynamicResource Str_Peek_Events}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorHistory" Content="{DynamicResource Str_Peek_History}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorServices" Content="{DynamicResource Str_Peek_Services}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorRestart" Content="{DynamicResource Str_Peek_Restart}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorSetup" Content="{DynamicResource Str_Peek_Setup}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorCompatibility" Content="{DynamicResource Str_Peek_Compatibility}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorReadiness" Content="{DynamicResource Str_Peek_Readiness}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorTransfers" Content="{DynamicResource Str_Peek_Transfers}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorDeliveryOptimization" Content="{DynamicResource Str_Peek_DeliveryOptimization}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorInstaller" Content="{DynamicResource Str_Peek_Installer}" IsChecked="True"/>
              <CheckBox x:Name="ServicingMonitorScheduledTask" Content="{DynamicResource Str_Peek_ScheduledTask}" IsChecked="True"/>
            </StackPanel>
            <StackPanel x:Name="SearchSettings" Visibility="Collapsed" Margin="0,0,0,8">
              <CheckBox x:Name="SearchIndexRebuildConsent" Content="{DynamicResource Str_Search_Rebuild}" Checked="OnSearchIndexRebuildChanged" Unchecked="OnSearchIndexRebuildChanged"/>
              <TextBlock Text="{DynamicResource Str_Search_RebuildDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AppPackageSettings" Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="{DynamicResource Str_Packages_Description}" TextWrapping="Wrap"/>
              <ComboBox x:Name="AppPackageScopeChoice" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="OnAppPackageScopeChanged" AutomationProperties.Name="Package inventory account scope">
                <ComboBoxItem Content="{DynamicResource Str_Scope_RunningAccount}"/>
                <ComboBoxItem Content="{DynamicResource Str_Scope_AllUsers}"/>
              </ComboBox>
              <ComboBox x:Name="AppPackageSelection" DisplayMemberPath="Name" Margin="0,6,0,6" AutomationProperties.Name="Registered package to review"/>
              <CheckBox x:Name="IncludeProvisionedPackages" Content="{DynamicResource Str_Packages_IncludeProvisioned}" ToolTip="{DynamicResource Str_Packages_IncludeProvisionedTip}" Margin="0,0,0,6"/>
              <Button Content="{DynamicResource Str_Packages_ReviewSelected}" Click="OnReviewAppPackage" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel x:Name="InstalledApplicationSettings" Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="{DynamicResource Str_Apps_Description}" TextWrapping="Wrap"/>
              <ComboBox x:Name="InstalledApplicationScopeChoice" SelectedIndex="0" SelectionChanged="OnApplicationScopeChanged" Margin="0,6,0,0" AutomationProperties.Name="Installed application registry scope">
                <ComboBoxItem Content="{DynamicResource Str_Scope_MachineWide}"/>
                <ComboBoxItem Content="{DynamicResource Str_Scope_RunningAccount}"/>
              </ComboBox>
              <Button x:Name="SaveApplicationInventory" Content="{DynamicResource Str_Apps_SaveInventory}" Click="OnSaveApplicationInventory" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="{DynamicResource Str_Apps_SaveInventoryTip}"/>
              <Button x:Name="CompareApplicationInventories" Content="{DynamicResource Str_Apps_CompareInventories}" Click="OnCompareApplicationInventories" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="{DynamicResource Str_Apps_CompareInventoriesTip}"/>
              <Button x:Name="ReviewBrowserExtensions" Content="{DynamicResource Str_Apps_ReviewExtensions}" Click="OnReviewBrowserExtensions" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="{DynamicResource Str_Apps_ReviewExtensionsTip}"/>
              <TextBlock Text="{DynamicResource Str_Apps_FolderName}" Margin="0,8,0,0"/>
              <DockPanel Margin="0,4,0,0" LastChildFill="False">
                <TextBox x:Name="ApplicationFolderName" Width="150" AutomationProperties.Name="{DynamicResource Str_Apps_FolderName}" ToolTip="{DynamicResource Str_Apps_FolderNameTip}"/>
                <Button x:Name="ReviewApplicationFoldersButton" Content="{DynamicResource Str_Apps_ReviewFolders}" Click="OnReviewApplicationFolders" Margin="6,0,0,0" ToolTip="{DynamicResource Str_Apps_ReviewFoldersTip}"/>
              </DockPanel>
            </StackPanel>
            <StackPanel x:Name="MaceSettings" Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="{DynamicResource Str_Mace_Description}" TextWrapping="Wrap"/>
              <ComboBox x:Name="MaceScopeChoice" SelectedIndex="0" Margin="0,6,0,6" AutomationProperties.Name="Microsoft app removal account scope" SelectionChanged="OnMaceOptionChanged">
                <ComboBoxItem Content="{DynamicResource Str_Scope_RunningAccount}"/><ComboBoxItem Content="{DynamicResource Str_Scope_AllUsersAndNew}"/>
              </ComboBox>
              <TextBlock Text="{DynamicResource Str_Common_Applications}" Foreground="{DynamicResource MutedTextBrush}"/>
              <CheckBox x:Name="MaceOneDrive" Content="OneDrive" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <CheckBox x:Name="MaceOutlook" Content="Outlook" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <CheckBox x:Name="MaceOffice" Content="Office / Microsoft 365" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <CheckBox x:Name="MaceProject" Content="Microsoft Project" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <CheckBox x:Name="MaceTeams" Content="Microsoft Teams" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <TextBlock Text="{DynamicResource Str_Mace_FutureChoices}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
              <CheckBox x:Name="MaceRemoveData" Content="{DynamicResource Str_Mace_RemoveData}" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
              <CheckBox x:Name="MaceRemoveCredentials" Content="{DynamicResource Str_Mace_RemoveCredentials}" Checked="OnMaceOptionChanged" Unchecked="OnMaceOptionChanged"/>
