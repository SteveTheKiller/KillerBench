<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KillerBench.csproj" />
    <ProjectReference Include="../Cli/KillerBench.Cli.csproj" />
  </ItemGroup>
  <!-- Application-relative font URIs resolve against this executable during hosted captures.
       Link the production font bytes at their production paths without changing app resources. -->
  <ItemGroup><Resource Include="../Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="../Cli/TaskPlanCommands.cs" Link="TaskPlanCommands.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/CommandLinePath.cs" Link="CommandLinePath.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/ImmutablePowerShell.cs" Link="ImmutablePowerShell.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/AppInfo.cs" Link="AppInfo.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/Preferences.cs" Link="Preferences.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/UpdateImagePublication.cs" Link="UpdateImagePublication.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/UpdateService.Relaunch.cs" Link="UpdateService.Relaunch.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Services/ExecutableDeployment.cs" Link="ExecutableDeployment.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Packaging/KillerLauncher/InstallerPrerequisitePolicy.cs" Link="InstallerPrerequisitePolicy.cs" /></ItemGroup>
</Project>
