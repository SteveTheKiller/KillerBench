<Window x:Class="KillerBench.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerBench.Controls"
        xmlns:local="clr-namespace:KillerBench.Controls"
        Title="KillerBench" Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <local:PickerBorder x:Name="RootBorder" Opacity="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}"
                        Margin="{DynamicResource DialogHaloMargin}">
        <local:PickerBorder.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </local:PickerBorder.Effect>
        <Grid>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}"
                    BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                    BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}"
                    BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                    BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                    Opacity="{DynamicResource GrainOpacity}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="{DynamicResource DialogTitleBarHeight}"
                        Background="{DynamicResource DialogTitleBarBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid>
                        <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                                Opacity="{DynamicResource GrainOpacity}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="{DynamicResource DialogTitleMargin}">
                            <icons:AppIcon x:Name="TitleIcon" Width="{DynamicResource TitleIconSize}"
                                   Height="{DynamicResource TitleIconSize}"
                                   Margin="{DynamicResource TitleIconMargin}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Grid VerticalAlignment="Center" Visibility="{DynamicResource WordmarkVisibility}" Margin="0,-18,0,-22">
                                <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                                <TextBlock Margin="1,2,0,0" IsHitTestVisible="False"
                                           Opacity="{DynamicResource WordmarkAccentShadowOpacity}"
                                           FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}">
                                    <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                                    <Run Text="Killer" Foreground="Transparent"/>
                                    <Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/>
                                </TextBlock>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}">
                                    <Run Text="Killer" Foreground="{DynamicResource ChromeTextBrush}"/>
                                    <Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="{DynamicResource TitleWordmarkBoldSize}"
                                         Foreground="{DynamicResource AccentLogo}"/>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="KillerBench" Visibility="{DynamicResource PlainTitleVisibility}"
                                       FontFamily="{DynamicResource ChromeFontFamily}"
                                       Foreground="{DynamicResource ChromeTextBrush}" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="CloseButton" Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click"
                                Style="{StaticResource OverlayCloseButton}"
                                Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="24,18,24,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- Notice ring, as in the family setup dialog: amber "!" on a confirmation, accent "i" on a notice. -->
                    <Border x:Name="NoticeRing" Width="28" Height="28" CornerRadius="14" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="NoticeGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource HeadingFont}" FontSize="18"
                                               TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <!-- Optional choice under the detail, such as the update prompt's "Always check on startup". -->
                    <CheckBox x:Name="Check1" Visibility="Collapsed" Margin="0,16,0,0" FontSize="12"
                              Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            IsCancel="True" IsDefault="True"
                            Style="{StaticResource SurfaceButton}" Height="28" MinWidth="80"
                            Padding="12,2" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="Remove" Click="OK_Click"
                            Style="{StaticResource OutlineButton}" Height="28" MinWidth="80" Padding="12,2"/>
                </StackPanel>
            </Grid>
        </Grid>
    </local:PickerBorder>
</Window>
