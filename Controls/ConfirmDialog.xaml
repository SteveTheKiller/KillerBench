<Window x:Class="KillerBench.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:KillerBench.Controls"
        xmlns:local="clr-namespace:KillerBench.Controls"
        Title="KillerBench" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <local:PickerBorder x:Name="RootBorder" Opacity="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}"
                        Margin="{DynamicResource DialogHaloMargin}">
        <local:PickerBorder.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </local:PickerBorder.Effect>
        <Grid>
            <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                    Opacity="{DynamicResource GrainOpacity}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="{DynamicResource DialogTitleBarHeight}"
                        Background="{DynamicResource DialogTitleBarBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                                Opacity="{DynamicResource GrainOpacity}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="{DynamicResource TitleBarPadding}">
                            <icons:AppIcon x:Name="TitleIcon" Width="{DynamicResource TitleIconSize}"
                                   Height="{DynamicResource TitleIconSize}"
                                   Margin="{DynamicResource TitleIconMargin}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Grid VerticalAlignment="Center" Visibility="{DynamicResource WordmarkVisibility}">
                                <TextBlock Margin="1,2,0,0" IsHitTestVisible="False"
                                           Opacity="{DynamicResource WordmarkAccentShadowOpacity}"
                                           FontFamily="{DynamicResource WordmarkFont}" FontSize="11.73">
                                    <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                                    <Run Text="Killer" Foreground="Transparent"/>
                                    <Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="17.62" Foreground="#D8000000"/>
                                </TextBlock>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="11.73">
                                    <Run Text="Killer" Foreground="{DynamicResource ChromeTextBrush}"/>
                                    <Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Bench" FontSize="17.62"
                                         Foreground="{DynamicResource AccentLogo}"/>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="KillerBench" Visibility="{DynamicResource PlainTitleVisibility}"
                                       FontFamily="{DynamicResource ChromeFontFamily}"
                                       Foreground="{DynamicResource ChromeTextBrush}" FontSize="11"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Click="Cancel_Click"
                                Style="{StaticResource ChromeCloseButton}"
                                Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            IsCancel="True" IsDefault="True"
                            Style="{StaticResource SurfaceButton}" MinWidth="80"
                            Padding="16,4" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="Remove" Click="OK_Click"
                            Style="{StaticResource OutlineButton}" MinWidth="80" Padding="16,4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </local:PickerBorder>
</Window>
