<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>killerbench-cli</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../LICENSE.txt" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../Engine/KillerBench.Engine.csproj" />
    <ProjectReference Include="../Engine.Windows/KillerBench.Engine.Windows.csproj" />
  </ItemGroup>
  <Target Name="EmbedSharedImplementationImages" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'KillerBench.Engine' Or '%(Filename)' == 'KillerBench.Engine.Core' Or '%(Filename)' == 'KillerBench.Engine.Windows'">
        <LogicalName>KillerBench.SharedImplementation.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
