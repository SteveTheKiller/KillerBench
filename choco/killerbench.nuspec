<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>killerbench</id>
    <version>1.0.0</version>
    <title>KillerBench</title>
    <authors>Steve the Killer</authors>
    <owners>SteveTheKiller</owners>
    <copyright>Copyright (c) Steve the Killer</copyright>
    <projectUrl>https://killerbench.net</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/SteveTheKiller/KillerBench@v1.0.0/Assets/AppIcon.png</iconUrl>
    <packageSourceUrl>https://github.com/SteveTheKiller/KillerBench</packageSourceUrl>
    <projectSourceUrl>https://github.com/SteveTheKiller/KillerBench</projectSourceUrl>
    <licenseUrl>https://github.com/SteveTheKiller/KillerBench/blob/v1.0.0/LICENSE.txt</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <docsUrl>https://killerbench.net/help.html</docsUrl>
    <bugTrackerUrl>https://github.com/SteveTheKiller/KillerBench/issues</bugTrackerUrl>
    <tags>windows diagnostics repair maintenance troubleshooting admin</tags>
    <summary>Windows diagnostics, guarded repairs, and maintenance tools with readable reports.</summary>
    <description>KillerBench is a Windows diagnostics, repair, and maintenance toolbox. Run a read-only system scan, review findings in readable reports or raw output, and explicitly confirm supported repairs. Tools cover Windows Update, services, networking, printing, storage, security, BitLocker, privacy, applications, and computer setup. Includes report export, 13 themes, and 20 interface languages. A separate CLI download supports scripting and integration. Free and open source under GPL v3.

This package installs the x64 desktop application and requires the .NET 10 Desktop Runtime. Uninstall removes application registration and shortcuts while preserving application files, reports, and settings.</description>
    <releaseNotes>https://github.com/SteveTheKiller/KillerBench/releases/tag/v1.0.0</releaseNotes>
    <dependencies>
      <dependency id="dotnet-10.0-desktopruntime" version="[10.0.0,11.0.0)" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
