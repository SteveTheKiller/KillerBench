<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <Content Include="Samples\*.log" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Compile Remove="Engine\**\*.cs;Engine.Core\**\*.cs;Engine.Windows\**\*.cs;Checks\**\*.cs;Cli\**\*.cs;Tools\**\*.cs" />
    <ProjectReference Include="Engine\KillerBench.Engine.csproj" />
    <ProjectReference Include="Engine.Windows\KillerBench.Engine.Windows.csproj" />
  </ItemGroup>
</Project>
