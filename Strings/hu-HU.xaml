  <sys:String x:Key="Str_BitLocker_ActionAddTpm">TPM-védő hozzáadása</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Helyreállítási jelszó hozzáadása</sys:String>
