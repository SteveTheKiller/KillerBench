  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Helyreállítási jelszó mentése a Microsoft Entra ID-ba</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">A meghajtó visszafejtése</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">A mentések a fent kiválasztott helyreállítási védőt használják. Minden művelet közvetlenül futás előtt megismétli az ellenőrzéseit, és soha nem ismétel meg megszakított kérést.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">A módosítás végrehajtása a kiválasztott meghajtón, amikor a Művelet futtatása gombra kattintok</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Tudomásul veszem, hogy a meghajtó védelem nélkül marad</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Előnézet</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Művelet futtatása</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Diagnosztikai csatorna</sys:String>
  <sys:String x:Key="Str_EventLog_System">Rendszer</sys:String>
  <sys:String x:Key="Str_EventLog_Application">Alkalmazás</sys:String>
