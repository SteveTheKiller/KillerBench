  <sys:String x:Key="Str_EventLog_Enable">Csatorna engedélyezése friss ellenőrzések után</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">A GO mindig mind a négy csatornát vizsgálja. Ez az opció csak a pontosan kiválasztott, letiltott, nem felügyelt csatornát módosítja, és ellenőrzi, hogy minden más jelentett csatornabeállítás változatlan maradt.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Gépnév-keresés (opcionális)</sys:String>
