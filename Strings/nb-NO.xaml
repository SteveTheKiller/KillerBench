  <sys:String x:Key="Str_Task_UserAccount">Brukerkonto (System bruker S-1-5-18)</sys:String>
  <sys:String x:Key="Str_Task_Highest">Høyeste rettigheter</sys:String>
  <sys:String x:Key="Str_Task_ExecutionLimit">Kjøretidsgrense (minutter, 1 til 4320)</sys:String>
  <sys:String x:Key="Str_Task_Overlap">Hvis en tidligere kjøring fortsatt er aktiv</sys:String>
  <sys:String x:Key="Str_Task_OverlapSkip">Hopp over den nye kjøringen</sys:String>
  <sys:String x:Key="Str_Task_OverlapQueue">Sett den nye kjøringen i kø</sys:String>
  <sys:String x:Key="Str_Task_OverlapParallel">Kjør begge samtidig</sys:String>
  <sys:String x:Key="Str_Task_OverlapStop">Stopp den forrige kjøringen</sys:String>
  <sys:String x:Key="Str_Task_ReviewDraft">Gjennomgå utkast</sys:String>
  <sys:String x:Key="Str_Task_InspectDraft">Inspiser utkast på denne PC-en</sys:String>
  <sys:String x:Key="Str_Task_InspectDraftTip">Les identiteten til den kjørbare filen og synlige oppgavekonflikter uten å registrere eller kjøre noe</sys:String>
  <sys:String x:Key="Str_Task_SaveDraft">Lagre nytt utkast...</sys:String>
  <sys:String x:Key="Str_Task_SaveDraftTip">Lagre til en ny JSON-fil; eksisterende filer beholdes</sys:String>
  <sys:String x:Key="Str_Task_StartDate">XML-startdato (ÅÅÅÅ-MM-DD)</sys:String>
  <sys:String x:Key="Str_Task_StartDateTip">Lokal startgrense i kalenderen; oppstartsutløsere bruker ikke denne datoen</sys:String>
  <sys:String x:Key="Str_Task_ExportXml">Eksporter XML for deaktivert oppgave...</sys:String>
  <sys:String x:Key="Str_Task_ExportXmlTip">Eksporter en ny gjennomgangsfil med lokal kalendertidssone. Ingen oppgave registreres eller kjøres; eksisterende filer beholdes</sys:String>
  <sys:String x:Key="Str_Task_RegisterConsent">Opprett denne deaktiverte oppgaven for Lokalt system etter nye kontroller</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistration">Forhåndsvis registrering</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistrationTip">Forhåndsvisning er standard. Oppretting krever den separate bekreftelsen, utvidede rettigheter, en gyldig signert kjørbar fil, en eksisterende mappe og et ikke-eksisterende nøyaktig mål.</sys:String>
  <sys:String x:Key="Str_Task_CheckInterrupted">Kontroller avbrutt registrering</sys:String>
  <sys:String x:Key="Str_Task_CheckInterruptedTip">Les den gjeldende nøyaktige oppgavedefinisjonen og lukk en samsvarende ventende sperre. Prøver aldri på nytt, aktiverer, kjører, erstatter eller sletter aldri en oppgave.</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlan">Gjennomgå lagret oppgaveplan...</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlanTip">Åpne en JSON-fil med oppgaveplan kun for gjennomgang</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecovery">Gjennomgå gjenopprettingsposter...</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecoveryTip">Velg én post eller et par av hensikt og fullføring. Gjennomgang endrer aldri en oppgave og tillater ikke nytt forsøk.</sys:String>
  <sys:String x:Key="Str_Task_Boundary">Kjør diagnose kartlegger eksisterende oppgaver. Registrering er atskilt, oppretter bare en deaktivert oppgave og kjører, erstatter eller sletter aldri en oppgave.</sys:String>
  <sys:String x:Key="Str_Cleanup_UserTemp">Midlertidige filer for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_WindowsTemp">Midlertidige Windows-filer</sys:String>
  <sys:String x:Key="Str_Cleanup_SystemTemp">Windows SystemTemp-filer</sys:String>
  <sys:String x:Key="Str_Cleanup_SystemTempTip">Bare standardmappen Windows SystemTemp. Nylige, beskyttede og filer som er i bruk, hoppes over. Administratortilgang kreves vanligvis.</sys:String>
  <sys:String x:Key="Str_Cleanup_ShaderCaches">Shader-hurtigbuffere for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_ShaderCachesTip">D3D, AMD DxCache og NVIDIA GLCache. Gjenoppbygging av hurtigbuffere kan gi innledende forsinkelser i gjengivelsen. Filer som er i bruk og nylige filer hoppes over.</sys:String>
  <sys:String x:Key="Str_Cleanup_BrowserCaches">Nettleserhurtigbuffere for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_BrowserCachesTip">Standard hurtigbuffermapper for Chrome, Edge, Brave, Firefox og Opera. Informasjonskapsler, pålogginger og bokmerker er utenfor disse målene. Egendefinerte plasseringer søkes ikke gjennom.</sys:String>
  <sys:String x:Key="Str_Cleanup_OfficeCaches">Office-hurtigbuffere for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_OfficeCachesTip">Bare standardmappene OfficeFileCache og OTele. Åpne eller nylige filer hoppes over. Office kan gjenoppbygge hurtigbufferfiler etter oppryddingen.</sys:String>
  <sys:String x:Key="Str_Cleanup_ThumbnailCache">Miniatyrbildehurtigbuffer for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_ThumbnailCacheTip">Bare Windows sine databasefiler for miniatyrbilder. Historikk i Filutforsker, nylige elementer og lagrede søk er utelatt. Windows gjenoppbygger miniatyrbilder etter hvert som mapper vises.</sys:String>
  <sys:String x:Key="Str_Cleanup_IconCache">Ikonhurtigbuffer for gjeldende bruker</sys:String>
  <sys:String x:Key="Str_Cleanup_IconCacheTip">Bare Windows sine ikondatabasefiler. Historikk i Filutforsker, nylige elementer og lagrede søk er utelatt. Windows gjenoppbygger ikoner ved behov.</sys:String>
  <sys:String x:Key="Str_Cleanup_ErrorReports">Arkiverte Windows-feilrapporter</sys:String>
