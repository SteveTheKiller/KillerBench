  <sys:String x:Key="Str_Audio_Multimedia">Multimedia</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Kommunikasjon</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">GO kontrollerer fortsatt alle lydenheter og drivere. Disse kontrollene begrenser detaljene som vises om standardendepunktet.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Klargjør ett gjenopprettingspunkt</sys:String>
