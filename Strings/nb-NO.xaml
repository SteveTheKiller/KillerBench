  <sys:String x:Key="Str_Network_ConnectionBoundary">Skriv inn både mål og port for å teste en tilkobling. Ingen programdata sendes.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">La stå tomt for å hoppe over. Bruker den konfigurerte resolveren; ingen DNS-innstillinger endres.</sys:String>
