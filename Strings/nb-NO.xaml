  <sys:String x:Key="Str_Task_TimeZone">Tidssone for kalender</sys:String>
  <sys:String x:Key="Str_Task_SelectWeekdays">Velg ukedager (Ctrl-klikk for flere)</sys:String>
  <sys:String x:Key="Str_Task_SelectMonthDays">Velg dager i måneden (Ctrl-klikk for flere)</sys:String>
  <sys:String x:Key="Str_Task_LastDay">Siste dag i stedet for valgte dager</sys:String>
  <sys:String x:Key="Str_Task_AccountMode">Kontomodus</sys:String>
  <sys:String x:Key="Str_Task_InteractiveUser">Interaktiv bruker</sys:String>
