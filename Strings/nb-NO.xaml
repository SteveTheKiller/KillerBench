  <sys:String x:Key="Str_Installer_ProductCode">Nøyaktig produktkode</sys:String>
  <sys:String x:Key="Str_Installer_Boundary">La stå tomt for generelle Installer-kontroller. GO kontrollerer det valgte produktet. Automatisk reparasjon er av med mindre du slår den på separat, og bare en nylig bekreftet ødelagt registrering er kvalifisert.</sys:String>
  <sys:String x:Key="Str_Time_KeepSource">Behold konfigurert kilde</sys:String>
  <sys:String x:Key="Str_Time_DomainHierarchy">Domenehierarki</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Egendefinerte NTP-partnere</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Opptil åtte NTP-vertsnavn eller IP-adresser, atskilt med mellomrom</sys:String>
  <sys:String x:Key="Str_Time_Apply">Bruk valgt kilde og synkroniser (kan endre klokken)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Kontroller avbrutt tidsendring</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Verifiser registrerte innstillinger uten å forsøke en endring på nytt</sys:String>
  <sys:String x:Key="Str_Time_Boundary">GO viser en forhåndsvisning av kildeendringer med mindre Bruk er valgt. Domenehierarki er begrenset til et domenemedlem som ikke er en domenekontroller. Hver endring krever nye kontroller av policy, rolle og utvidede rettigheter. Ingen automatisk tilbakerulling.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Minste antall dager siden siste bruk (bare gjennomgang):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Kontroller avhengigheter til tjenester og planlagte oppgaver</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Velg profiler etter gjennomgang</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Forhåndsvis valgte profiler</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Sikkerhetskopier og verifiser en profil</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Velg nøyaktig én gjennomgått profil. For å ta en ny sikkerhetskopi skriver du en ny lokal NTFS-mappe som ikke finnes. For å inspisere en eksisterende kopi velger du mappen den ligger i. KillerBench sletter aldri profilen.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Bla gjennom</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">En ny, ikke-eksisterende lokal NTFS-mappe for kopiering, eller en eksisterende kopiert profilmappe for verifisering</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Kopier og verifiser</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Kopier den valgte, ikke-innlastede profilen én gang til en ny, tom lokal NTFS-mappe, og verifiser deretter hver vanlige fil</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Opprett verifiseringsfiler</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Sammenlign den valgte aktive profilen med den eksisterende kopierte mappen, og opprett deretter manifestet og kvitteringen</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Verifiser kopiert sikkerhetskopi</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Verifiser det eksisterende manifestet og kvitteringen mot både den aktive profilen og den kopierte mappen</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Kontroller avbrutt sikkerhetskopiering</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Verifiser en ventende sikkerhetskopi uten å kopiere filer på nytt</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">Verifiseringen sammenligner hele settet med vanlige filer, lengder og SHA-256-hasher. Den beviser ikke tillatelser, alternative strømmer, krypterte filer, apptilstand eller gjenopprettingsatferd.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Velg områder som skal inspiseres. Egne beskyttede kontroller er tilgjengelige for utklippstavlen og støttede kontoinnstillinger, inkludert kamera- og mikrofontilgang.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Utklippstavlelogg</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Bare inspiser</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Slå på</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Slå av</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Bruk når jeg trykker GO</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Verktøy</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Personverninnstilling</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Handling</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Bruk endrer bare denne kontoen. Samsvarende policy, enhetstilgang for hele maskinen, unntak per program, diagnoseinnsamling og lagret utklippstavleinnhold beholdes. Verifiserte journaler støtter beskyttet angring.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">GO inspiserer som standard. Sikkerhetskopiering, kryptering og gjenopptakelse av beskyttelse krever hver sin tilhørende bekreftelse nedenfor.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Volum</sys:String>
  <sys:String x:Key="Str_BitLocker_Operation">Operasjon</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Kryptering</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Gjenopprettingskopi</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Bare brukt plass</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Sikkerhetskopifil (for filmål)</sys:String>
  <sys:String x:Key="Str_BitLocker_Browse">Bla gjennom...</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">For filsikkerhetskopi skriver du en full sti utenfor det beskyttede volumet.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Finn gjenopprettingsbeskyttere</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Skriv valgt gjenopprettingskopi når jeg trykker GO</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Sikkerhetskopier den valgte gjenopprettingsnøkkelen, og start deretter krypteringen når jeg trykker GO</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Gjenoppta beskyttelsen på dette fullt krypterte volumet når jeg trykker GO</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">Kryptering krever den valgte beskytteren for gjenopprettingspassord og en ny, verifisert sikkerhetskopifil utenfor det beskyttede volumet. Windows-stasjonen trenger også sin TPM-beskytter. Eksisterende beskyttere og administrert policy beholdes.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Flere BitLocker-handlinger</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Handling</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Slå på automatisk opplåsing</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Legg til en TPM-beskytter</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Legg til et gjenopprettingspassord</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Sikkerhetskopier gjenopprettingspassordet til Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Sikkerhetskopier gjenopprettingspassordet til Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Dekrypter denne stasjonen</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Sikkerhetskopier bruker gjenopprettingsbeskytteren som er valgt ovenfor. Hver handling gjentar kontrollene rett før den kjøres, og gjentar aldri en avbrutt forespørsel.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Gjør denne endringen på den valgte stasjonen når jeg trykker Kjør handling</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Jeg forstår at stasjonen blir ubeskyttet</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Forhåndsvis</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Kjør handling</sys:String>
