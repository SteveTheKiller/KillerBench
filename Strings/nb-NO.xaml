  <sys:String x:Key="Str_EventLog_WindowsUpdate">Windows Update-klient / Drift</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Aktiver denne kanalen etter nye kontroller</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">GO inspiserer alltid alle fire kanalene. Dette alternativet endrer bare den nøyaktig valgte deaktiverte, uadministrerte kanalen og verifiserer at alle andre rapporterte kanalinnstillinger er uendret.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Vertsnavnoppslag (valgfritt)</sys:String>
  <sys:String x:Key="Str_Network_Destination">TCP-mål (valgfritt)</sys:String>
