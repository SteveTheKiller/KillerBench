  <sys:String x:Key="Str_Restore_SystemSettings">Endring av systeminnstillinger</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Programinstallasjon</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Installasjon av enhetsdriver</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">GO viser eksisterende punkter med mindre dette alternativet er valgt. Velg automatisk handling nedenfor for å be om ett punkt etter nye kontroller. Windows sine frekvensgrenser og beskyttelsespolicy beholdes.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Volum som skal kontrolleres</sys:String>
  <sys:String x:Key="Str_Storage_Description">Kontrollerer dette NTFS-volumet pluss disk- og kontrollerenheter på hele PC-en. Enhetsfunn knyttes ikke til dette volumet. Ingen reparasjon eller omstart planlegges.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Gjennomgå filsystemreparasjon</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Punktreparasjon</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Frakoblet skanning og reparasjon</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">La et volum som ikke er systemvolum, gå frakoblet</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Viktige data på dette volumet er sikkerhetskopiert</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analyser stasjonsoptimalisering</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Anbefalt av Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Kjør Retrim på SSD-lagring</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Defragmenter harddisk</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">GO samler alltid inn aktuelle bevis først. Filsystemreparasjon og stasjonsoptimalisering er separate valg. Optimalisering krever en bekreftet medietype og endrer aldri tidsplaner eller starter Windows på nytt.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">GO kontrollerer om Windows anbefaler opprydding. Valgfri opprydding fjerner erstattede komponenter umiddelbart; ingen automatisk angring eller omstart. Frigjort plass måles ikke.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Gjennomgå valgt mappe</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Finn duplikatfiler eller store filer i én valgt lokal mappe. Begge gjennomgangene er skrivebeskyttet og velger aldri filer for sletting.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Bla gjennom</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Én lokal mappe. Reparsepunkter og utilgjengelig innhold utelates.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Finn duplikater</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Skrivebeskyttet SHA-256-gjennomgang av duplikater</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Finn store filer</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Skrivebeskyttet gjennomgang av filer på minst 100 MB</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Foreslått datamaskinnavn</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Gi denne arbeidsgruppe-PC-en nytt navn etter nye kontroller</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">GO gjennomgår navnet og gjeldende identitet. Når alternativet for å gi nytt navn er valgt, er bare en frittstående arbeidsgruppe-PC med klare forutsetninger kvalifisert. KillerBench starter aldri Windows på nytt.</sys:String>
  <sys:String x:Key="Str_Main_AutoRepair">Reparer bekreftede problemer automatisk</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosis">Kjør diagnose</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosisTip">Kjør de valgte skrivebeskyttede kontrollene og åpne en lesbar rapport.</sys:String>
  <sys:String x:Key="Str_Main_Stop">Stopp</sys:String>
  <sys:String x:Key="Str_Main_StopTip">Stopp etter gjeldende kommando (Esc)</sys:String>
