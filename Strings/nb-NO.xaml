  <sys:String x:Key="Str_Installer_Boundary">La stå tomt for generelle Installer-kontroller. Kjør-knappen kontrollerer det valgte produktet. Automatisk reparasjon forblir av med mindre du slår den på separat, og bare en nylig bekreftet ødelagt registrering er kvalifisert.</sys:String>
  <sys:String x:Key="Str_Time_KeepSource">Behold konfigurert kilde</sys:String>
  <sys:String x:Key="Str_Time_DomainHierarchy">Domenehierarki</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Egendefinerte NTP-partnere</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Opptil åtte NTP-vertsnavn eller IP-adresser, atskilt med mellomrom</sys:String>
  <sys:String x:Key="Str_Time_Apply">Bruk valgt kilde og synkroniser (kan endre klokken)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Kontroller avbrutt tidsendring</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Verifiser registrerte innstillinger uten å forsøke en endring på nytt</sys:String>
  <sys:String x:Key="Str_Time_Boundary">Kjør diagnose forhåndsviser kildeendringer med mindre Bruk er valgt. Domenehierarki er begrenset til et domenemedlem som ikke er domenekontroller. Hver endring krever nye kontroller av policy, rolle og utvidede rettigheter. Ingen automatisk tilbakestilling.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Minste antall dager siden siste bruk (bare gjennomgang):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Kontroller avhengigheter til tjenester og planlagte oppgaver</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Velg profiler etter gjennomgang</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Forhåndsvis valgte profiler</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Sikkerhetskopier og verifiser en profil</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Velg nøyaktig én gjennomgått profil. For å ta en ny sikkerhetskopi skriver du en ny lokal NTFS-mappe som ikke finnes. For å inspisere en eksisterende kopi velger du mappen den ligger i. KillerBench sletter aldri profilen.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Bla gjennom</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">En ny, ikke-eksisterende lokal NTFS-mappe for kopiering, eller en eksisterende kopiert profilmappe for verifisering</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Kopier og verifiser</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Kopier den valgte, ikke-innlastede profilen én gang til en ny, tom lokal NTFS-mappe, og verifiser deretter hver vanlige fil</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Opprett verifiseringsfiler</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Sammenlign den valgte aktive profilen med den eksisterende kopierte mappen, og opprett deretter manifestet og kvitteringen</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Verifiser kopiert sikkerhetskopi</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Verifiser det eksisterende manifestet og kvitteringen mot både den aktive profilen og den kopierte mappen</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Kontroller avbrutt sikkerhetskopiering</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Verifiser en ventende sikkerhetskopi uten å kopiere filer på nytt</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">Verifiseringen sammenligner hele settet med vanlige filer, lengder og SHA-256-hasher. Den beviser ikke tillatelser, alternative strømmer, krypterte filer, apptilstand eller gjenopprettingsatferd.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Velg områder som skal inspiseres. Egne beskyttede kontroller er tilgjengelige for utklippstavlen og støttede kontoinnstillinger, inkludert kamera- og mikrofontilgang.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Utklippstavlelogg</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Bare inspiser</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Slå på</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Slå av</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Bruk når jeg velger Kjør diagnose</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Verktøy</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Personverninnstilling</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Handling</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Endringer gjelder bare denne kontoen. Samsvarende policy, enhetstilgang for hele maskinen, unntak per program, diagnoseinnsamling og lagret utklippstavleinnhold beholdes. Verifiserte journaler støtter beskyttet angring.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">Kjør diagnose inspiserer som standard. Sikkerhetskopiering, kryptering og gjenopptatt beskyttelse krever hver sin bekreftelse nedenfor.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Volum</sys:String>
  <sys:String x:Key="Str_BitLocker_Operation">Operasjon</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Kryptering</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Gjenopprettingskopi</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Bare brukt plass</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Sikkerhetskopifil (for filmål)</sys:String>
  <sys:String x:Key="Str_BitLocker_Browse">Bla gjennom...</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">For filsikkerhetskopi skriver du en full sti utenfor det beskyttede volumet.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Finn gjenopprettingsbeskyttere</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Skriv den valgte gjenopprettingskopien når jeg velger Kjør diagnose</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Sikkerhetskopier den valgte gjenopprettingsnøkkelen, og start deretter krypteringen når jeg velger Kjør diagnose</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Gjenoppta beskyttelsen på dette fullstendig krypterte volumet når jeg velger Kjør diagnose</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">Kryptering krever den valgte beskytteren for gjenopprettingspassord og en ny, verifisert sikkerhetskopifil utenfor det beskyttede volumet. Windows-stasjonen trenger også sin TPM-beskytter. Eksisterende beskyttere og administrert policy beholdes.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Flere BitLocker-handlinger</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Handling</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Slå på automatisk opplåsing</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Legg til en TPM-beskytter</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Legg til et gjenopprettingspassord</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Sikkerhetskopier gjenopprettingspassordet til Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Sikkerhetskopier gjenopprettingspassordet til Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Dekrypter denne stasjonen</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Sikkerhetskopier bruker gjenopprettingsbeskytteren som er valgt ovenfor. Hver handling gjentar kontrollene rett før den kjøres, og gjentar aldri en avbrutt forespørsel.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Gjør denne endringen på den valgte stasjonen når jeg trykker Kjør handling</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Jeg forstår at stasjonen blir ubeskyttet</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Forhåndsvis</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Kjør handling</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Diagnosekanal</sys:String>
  <sys:String x:Key="Str_EventLog_System">System</sys:String>
  <sys:String x:Key="Str_EventLog_Application">Program</sys:String>
  <sys:String x:Key="Str_EventLog_Setup">Oppsett</sys:String>
  <sys:String x:Key="Str_EventLog_WindowsUpdate">Windows Update-klient / Drift</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Aktiver denne kanalen etter nye kontroller</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">Kjør-knappen inspiserer alltid alle fire kanalene. Dette alternativet endrer bare den nøyaktig valgte deaktiverte, uadministrerte kanalen og verifiserer at alle andre rapporterte kanalinnstillinger forble uendret.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Vertsnavnoppslag (valgfritt)</sys:String>
  <sys:String x:Key="Str_Network_Destination">TCP-mål (valgfritt)</sys:String>
  <sys:String x:Key="Str_Network_Port">TCP-port</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Tidsavbrudd per oppslag eller tilkobling (sekunder)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Skriv inn både mål og port for å teste en tilkobling. Ingen programdata sendes.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">La stå tomt for å hoppe over. Bruker den konfigurerte resolveren; ingen DNS-innstillinger endres.</sys:String>
  <sys:String x:Key="Str_Audio_EndpointScope">Omfang for standardendepunkt</sys:String>
  <sys:String x:Key="Str_Audio_InputOutput">Inndata og utdata</sys:String>
  <sys:String x:Key="Str_Audio_Output">Utdata</sys:String>
  <sys:String x:Key="Str_Audio_Input">Inndata</sys:String>
  <sys:String x:Key="Str_Audio_WindowsRole">Windows-rolle</sys:String>
  <sys:String x:Key="Str_Audio_AllRoles">Alle roller</sys:String>
  <sys:String x:Key="Str_Audio_Console">Konsoll</sys:String>
  <sys:String x:Key="Str_Audio_Multimedia">Multimedia</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Kommunikasjon</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">Kjør-knappen kontrollerer fortsatt alle lydenheter og drivere. Disse kontrollene begrenser bare detaljene som vises for standardendepunktet.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Klargjør ett gjenopprettingspunkt</sys:String>
  <sys:String x:Key="Str_Restore_Description">Beskrivelse</sys:String>
  <sys:String x:Key="Str_Restore_DefaultDescription">Før vedlikehold med KillerBench</sys:String>
  <sys:String x:Key="Str_Restore_Reason">Årsak</sys:String>
  <sys:String x:Key="Str_Restore_SystemSettings">Endring av systeminnstillinger</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Programinstallasjon</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Installasjon av enhetsdriver</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">Kjør-knappen viser eksisterende punkter med mindre dette alternativet er valgt. Velg automatisk handling nedenfor for å be om ett punkt etter nye kontroller. Windows sine frekvensgrenser og beskyttelsespolicy bevares.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Volum som skal kontrolleres</sys:String>
  <sys:String x:Key="Str_Storage_Description">Kontrollerer dette NTFS-volumet pluss disk- og kontrollerenheter på hele PC-en. Enhetsfunn knyttes ikke til dette volumet. Ingen reparasjon eller omstart planlegges.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Gjennomgå filsystemreparasjon</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Punktreparasjon</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Frakoblet skanning og reparasjon</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">La et volum som ikke er systemvolum, gå frakoblet</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Viktige data på dette volumet er sikkerhetskopiert</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analyser stasjonsoptimalisering</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Anbefalt av Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Kjør Retrim på SSD-lagring</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Defragmenter harddisk</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">Kjør-knappen samler alltid inn gjeldende bevis først. Filsystemreparasjon og stasjonsoptimalisering er separate valg. Optimalisering krever en bekreftet medietype og endrer aldri tidsplaner eller starter Windows på nytt.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">Kjør-knappen kontrollerer om Windows anbefaler opprydding. Valgfri opprydding fjerner erstattede komponenter umiddelbart; ingen automatisk angring eller omstart. Frigjort plass måles ikke.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Gjennomgå valgt mappe</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Finn duplikatfiler eller store filer i én valgt lokal mappe. Begge gjennomgangene er skrivebeskyttet og velger aldri filer for sletting.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Bla gjennom</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Én lokal mappe. Reparsepunkter og utilgjengelig innhold utelates.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Finn duplikater</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Skrivebeskyttet SHA-256-gjennomgang av duplikater</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Finn store filer</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Skrivebeskyttet gjennomgang av filer på minst 100 MB</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Foreslått datamaskinnavn</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Gi denne arbeidsgruppe-PC-en nytt navn etter nye kontroller</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">Kjør diagnose gjennomgår navnet og gjeldende identitet. Med alternativet for nytt navn valgt er bare en frittstående arbeidsgruppe-PC med klare forutsetninger kvalifisert. KillerBench starter aldri Windows på nytt.</sys:String>
  <sys:String x:Key="Str_Main_AutoRepair">Reparer bekreftede problemer automatisk</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosis">Kjør diagnose</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosisTip">Kjør de valgte skrivebeskyttede kontrollene og åpne en lesbar rapport.</sys:String>
  <sys:String x:Key="Str_Main_Stop">Stopp</sys:String>
  <sys:String x:Key="Str_Main_StopTip">Stopp etter gjeldende kommando (Esc)</sys:String>
  <sys:String x:Key="Str_Task_NewDraft">Nytt oppgaveutkast</sys:String>
