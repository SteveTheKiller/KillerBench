  <sys:String x:Key="Str_EventLog_WindowsUpdate">Máy khách Cập nhật Windows / Hoạt động</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Kích hoạt kênh này sau khi kiểm tra mới</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">GO luôn kiểm tra tất cả bốn kênh. Tùy chọn này chỉ thay đổi đúng kênh bị vô hiệu hóa, không quản lý được chọn và xác minh rằng mọi cài đặt kênh được báo cáo khác vẫn không thay đổi.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Tra cứu tên máy chủ (tùy chọn)</sys:String>
  <sys:String x:Key="Str_Network_Destination">Đích TCP (tùy chọn)</sys:String>
  <sys:String x:Key="Str_Network_Port">Cổng TCP</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Thời gian chờ cho mỗi lượt tra cứu hoặc kết nối (giây)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Nhập cả đích đến và cổng để kiểm tra kết nối. Không có dữ liệu ứng dụng nào được gửi.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">Để trống để bỏ qua. Sử dụng bộ phân giải bạn đã cấu hình; không thay đổi cài đặt DNS nào.</sys:String>
