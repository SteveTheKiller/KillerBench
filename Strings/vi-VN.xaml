  <sys:String x:Key="Str_Peek_Setup">Hoạt động thiết lập Panther</sys:String>
  <sys:String x:Key="Str_Peek_Compatibility">Thiết lập các khối tương thích</sys:String>
  <sys:String x:Key="Str_Peek_Readiness">Dung lượng lưu trữ, năng lượng và sẵn sàng cho BitLocker</sys:String>
  <sys:String x:Key="Str_Peek_Transfers">Truyền dữ liệu nền của tài khoản hiện tại</sys:String>
  <sys:String x:Key="Str_Peek_DeliveryOptimization">Hoạt động Tối ưu hóa Phân phối</sys:String>
  <sys:String x:Key="Str_Peek_Installer">Hoạt động Windows Installer</sys:String>
  <sys:String x:Key="Str_Peek_ScheduledTask">Tác vụ đã lên lịch của Windows Update</sys:String>
  <sys:String x:Key="Str_Search_Rebuild">Xây dựng lại chỉ mục Tìm kiếm của Windows</sys:String>
  <sys:String x:Key="Str_Search_RebuildDescription">Dừng Windows Search, giữ lại chỉ mục hiện tại, bắt đầu một chỉ mục mới và kiểm tra dịch vụ cùng cả hai thư mục. Chỉ mục được giữ lại sẽ không bị xóa tự động.</sys:String>
  <sys:String x:Key="Str_Packages_Description">Chọn phạm vi tài khoản, sau đó nhấn GO để làm mới gói. Tất cả người dùng đều yêu cầu quyền quản trị viên.</sys:String>
  <sys:String x:Key="Str_Scope_RunningAccount">Tài khoản hiện tại</sys:String>
  <sys:String x:Key="Str_Scope_AllUsers">Tất cả người dùng</sys:String>
  <sys:String x:Key="Str_Scope_MachineWide">Toàn máy</sys:String>
  <sys:String x:Key="Str_Packages_IncludeProvisioned">Bao gồm các gói cho người dùng mới</sys:String>
  <sys:String x:Key="Str_Packages_IncludeProvisionedTip">Cũng đọc các gói đã được cấp sẵn trong ảnh Windows. Yêu cầu quyền quản trị viên.</sys:String>
  <sys:String x:Key="Str_Packages_ReviewSelected">Xem lại gói đã chọn</sys:String>
  <sys:String x:Key="Str_Apps_Description">Chọn những đăng ký nào sẽ thu thập. Tài khoản đang chạy có nghĩa là tài khoản đang thực thi KillerBench.</sys:String>
  <sys:String x:Key="Str_Apps_SaveInventory">Lưu danh sách...</sys:String>
  <sys:String x:Key="Str_Apps_SaveInventoryTip">Lưu các mục đăng ký từ lần thu thập hoàn tất gần nhất, bao gồm mọi giới hạn phạm vi.</sys:String>
  <sys:String x:Key="Str_Apps_CompareInventories">So sánh các danh sách đã lưu...</sys:String>
  <sys:String x:Key="Str_Apps_CompareInventoriesTip">Chọn các tệp JSON của ứng dụng đã cài đặt trước và sau. Không có ứng dụng nào bị thay đổi.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensions">Đánh giá các tiện ích mở rộng trình duyệt</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensionsTip">Đọc danh tính tiện ích mở rộng của Chrome, Edge, Brave và Firefox. Không thay đổi trình duyệt, tiện ích mở rộng hoặc chính sách nào.</sys:String>
  <sys:String x:Key="Str_Apps_FolderName">Tên thư mục ứng dụng chính xác</sys:String>
  <sys:String x:Key="Str_Apps_FolderNameTip">Chỉ một tên thư mục. Năm vị trí cố định được kiểm tra mà không đọc nội dung.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFolders">Xem lại các thư mục</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFoldersTip">Xem xét chỉ đọc của năm vị trí thư mục ứng dụng chính xác. Không có nội dung, đường dẫn hoặc tệp nào được hiển thị hoặc thay đổi.</sys:String>
  <sys:String x:Key="Str_Scope_AllUsersAndNew">Tất cả người dùng và người dùng mới</sys:String>
  <sys:String x:Key="Str_Common_Applications">Ứng dụng</sys:String>
  <sys:String x:Key="Str_Common_Both">Cả hai</sys:String>
  <sys:String x:Key="Str_Mace_Description">Chọn chính xác những gì cần xem lại. GO kiểm kê đăng ký và hiển thị hậu quả. Việc gỡ bỏ gói có kiểm soát riêng của nó.</sys:String>
  <sys:String x:Key="Str_Mace_FutureChoices">Các lựa chọn loại bỏ trong tương lai</sys:String>
  <sys:String x:Key="Str_Mace_RemoveData">Xóa dữ liệu hồ sơ của các ứng dụng đã chọn</sys:String>
  <sys:String x:Key="Str_Mace_RemoveCredentials">Xóa thông tin xác thực đã lưu trong bộ nhớ đệm của các ứng dụng đã chọn</sys:String>
  <sys:String x:Key="Str_Mace_RestoreFolders">Xem lại vị trí thư mục OneDrive để khôi phục</sys:String>
  <sys:String x:Key="Str_Mace_ReviewBoundary">GO chỉ ghi lại những lựa chọn này trong bản đánh giá. Không có thay đổi nào đối với quy trình, ứng dụng, gói, tệp, thông tin xác thực, vị trí thư mục, giá trị đăng ký hoặc dữ liệu người dùng.</sys:String>
  <sys:String x:Key="Str_Mace_PackagePlan">Kế hoạch gói được hỗ trợ</sys:String>
  <sys:String x:Key="Str_Mace_CheckPackage">Kiểm tra gói đã chọn</sys:String>
  <sys:String x:Key="Str_Mace_PackageHint">Chạy GO để tìm các ứng viên gói tài khoản hiện tại được hỗ trợ.</sys:String>
  <sys:String x:Key="Str_Mace_DestructiveRemoval">Gỡ bỏ gói phần mềm có tính hủy hoại</sys:String>
  <sys:String x:Key="Str_Mace_RemovalConsent">Tôi hiểu rằng điều này chỉ gỡ bỏ gói đã chọn sau khi các biện pháp bảo vệ mới được thực hiện xong</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackage">GỠ BỎ GÓI ĐÃ CHỌN</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackageTip">Yêu cầu một đánh giá đủ điều kiện, xác nhận này, một xác nhận thứ hai, và bằng chứng chính xác mới trước khi yêu cầu gỡ bỏ.</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterrupted">Kiểm tra việc loại bỏ bị gián đoạn</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterruptedTip">Kiểm tra một hồ sơ gỡ bỏ gói trước đó mà không gửi yêu cầu gỡ bỏ khác.</sys:String>
  <sys:String x:Key="Str_Mace_RemovalBoundary">Điều khiển màu đỏ này tách biệt với GO. Nó chỉ xóa một gói phát triển chính xác, không được bảo vệ cho tài khoản đang hoạt động. Yêu cầu cuối cùng được ghi lại và không bao giờ được thử lại tự động.</sys:String>
  <sys:String x:Key="Str_Orca_Description">Chọn phiên bản Outlook, phạm vi tài khoản và các khu vực đặt lại chính xác. GO xem xét chúng. Chỉ đối với bộ nhớ đệm tài khoản đang chạy, bật giữ lại để chuyển bộ nhớ đệm sang tên khôi phục sau khi kiểm tra mới.</sys:String>
  <sys:String x:Key="Str_Orca_NewOutlook">Outlook mới</sys:String>
  <sys:String x:Key="Str_Orca_ClassicOutlook">Outlook cổ điển</sys:String>
  <sys:String x:Key="Str_Orca_ResetAreas">Đặt lại các khu vực</sys:String>
  <sys:String x:Key="Str_Orca_Caches">Bộ nhớ đệm Outlook</sys:String>
  <sys:String x:Key="Str_Orca_Profiles">Cài đặt hồ sơ và khám phá</sys:String>
  <sys:String x:Key="Str_Orca_Authentication">Trạng thái xác thực</sys:String>
  <sys:String x:Key="Str_Orca_OstFiles">Tệp OST Outlook cổ điển</sys:String>
  <sys:String x:Key="Str_Orca_AddIns">Tiện ích bổ sung Outlook cổ điển</sys:String>
  <sys:String x:Key="Str_Orca_ReinstallNew">Cài đặt lại Outlook mới</sys:String>
  <sys:String x:Key="Str_Orca_Boundary">Chỉ lưu giữ bộ nhớ đệm. Hồ sơ, tệp OST, thông tin đăng nhập, tiện ích bổ sung, gói, cài đặt và bộ nhớ đệm được giữ lại sẽ không bao giờ bị xóa.</sys:String>
  <sys:String x:Key="Str_Common_Configuration">Cấu hình</sys:String>
  <sys:String x:Key="Str_Depot_Description">Chọn các ứng dụng và nhóm cấu hình để xem xét cung cấp. Không có gì được chọn hoặc cài đặt tự động.</sys:String>
  <sys:String x:Key="Str_Depot_WindowsUpdates">Cập nhật Windows</sys:String>
  <sys:String x:Key="Str_Depot_ComputerName">Tên máy tính</sys:String>
  <sys:String x:Key="Str_Depot_LocalAdministrator">Quản trị viên cục bộ</sys:String>
  <sys:String x:Key="Str_Depot_AdministratorReview">Xem xét của quản trị viên</sys:String>
  <sys:String x:Key="Str_Depot_Cleanup">Dọn dẹp</sys:String>
