  <sys:String x:Key="Str_RecordedEvidence">Các sự kiện đã ghi không xác định được tình trạng hiện tại của máy. Không có sửa chữa nào được thực hiện.</sys:String>
  <sys:String x:Key="Str_ScanUpdate">Quét Cập nhật Windows</sys:String>
  <sys:String x:Key="Str_ScanUpdateTip">Đọc CBS, Panther và các sự kiện gần đây. Không sửa chữa. Esc dừng việc thu thập.</sys:String>
  <sys:String x:Key="Str_OpenCapture">Mở ảnh chụp</sys:String>
  <sys:String x:Key="Str_SaveCapture">Lưu ảnh chụp</sys:String>
  <sys:String x:Key="Str_CaptureScope">Quét chỉ đọc. Ảnh chụp nhanh CBS và Panther, lên đến 200 sự kiện mỗi kênh từ 7 ngày qua. Nhấn Esc để dừng.</sys:String>
  <sys:String x:Key="Str_ExportActivity">Xuất khẩu...</sys:String>
  <sys:String x:Key="Str_ExportActivityHint">Xuất hoạt động phiên đã lưu dưới dạng TXT, CSV hoặc HTML (tối đa 150 mục)</sys:String>
  <sys:String x:Key="Str_Peek_Description">Xem hoạt động Cập nhật và Cài đặt Windows. Bộ theo dõi này chỉ đọc và không quyết định rằng hoạt động đó bị mắc kẹt.</sys:String>
