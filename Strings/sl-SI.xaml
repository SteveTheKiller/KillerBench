  <sys:String x:Key="Str_Task_StartDate">Začetni datum XML (YYYY-MM-DD)</sys:String>
  <sys:String x:Key="Str_Task_StartDateTip">Začetna meja lokalnega koledarja; sprožilci ob zagonu tega datuma ne uporabljajo</sys:String>
  <sys:String x:Key="Str_Task_ExportXml">Izvozi XML onemogočenega opravila...</sys:String>
  <sys:String x:Key="Str_Task_ExportXmlTip">Izvozi novo datoteko za pregled v časovnem pasu lokalnega koledarja. Opravilo se ne registrira ali zažene; obstoječe datoteke se ohranijo</sys:String>
  <sys:String x:Key="Str_Task_RegisterConsent">Po ponovnem preverjanju ustvari to onemogočeno opravilo Local System</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistration">Predogled registracije</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistrationTip">Privzeto samo predogled. Ustvarjanje zahteva ločeno potrditev, povišane pravice, veljavno podpisano izvršljivo datoteko, obstoječo mapo in točen cilj, ki še ne obstaja.</sys:String>
  <sys:String x:Key="Str_Task_CheckInterrupted">Preveri prekinjeno registracijo</sys:String>
  <sys:String x:Key="Str_Task_CheckInterruptedTip">Prebere trenutno točno definicijo opravila in zaključi ustrezno čakajočo zaščitno evidenco. Opravila nikoli ne ponovi, omogoči, zažene, zamenja ali izbriše.</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlan">Preglej shranjeni načrt opravila...</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlanTip">Odpri datoteko JSON z načrtom opravila samo za pregled</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecovery">Preglej zapise obnovitve...</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecoveryTip">Izberite en zapis ali par namera/dokončanje. Pregled nikoli ne spremeni opravila ali dovoli ponovnega poskusa.</sys:String>
