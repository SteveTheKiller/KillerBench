  <sys:String x:Key="Str_Task_InspectDraft">Preveri osnutek na tem računalniku</sys:String>
  <sys:String x:Key="Str_Task_InspectDraftTip">Preberi identiteto izvršljive datoteke in vidna navzkrižja opravil brez registracije ali zagona</sys:String>
  <sys:String x:Key="Str_Task_SaveDraft">Shrani nov osnutek...</sys:String>
