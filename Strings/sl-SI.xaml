  <sys:String x:Key="Str_Main_RunDiagnosis">Zaženi diagnostiko</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosisTip">Izvedi izbrana preverjanja samo za branje in odpri pregledno poročilo.</sys:String>
