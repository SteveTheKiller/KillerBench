  <sys:String x:Key="Str_Print_FindPrinters">Poišči lokalne tiskalnike</sys:String>
  <sys:String x:Key="Str_Print_RepairDefault">S to čakalno vrsto popravi manjkajočo ali nasprotujočo si privzeto izbiro</sys:String>
  <sys:String x:Key="Str_Print_FindBlockedJobs">Poišči blokirana tiskalna opravila</sys:String>
  <sys:String x:Key="Str_Print_CancelSelected">Prekliči samo to izbrano opravilo</sys:String>
  <sys:String x:Key="Str_Print_CheckInterrupted">Preveri prekinjen preklic opravila</sys:String>
  <sys:String x:Key="Str_Print_GeneralChecks">Uporabi splošna preverjanja tiskanja</sys:String>
  <sys:String x:Key="Str_Print_Boundary">Gumb Zaženi preveri izbrano čakalno vrsto. Izbrano opravilo s stanjem Napaka ali Blokirano je mogoče preklicati šele po ločeni potrditvi. Vsa druga opažena opravila morajo ostati v vrsti. Popravilo privzete izbire je omejeno na manjkajoče ali nasprotujoče si privzete izbire. Brez izbire se izvedejo splošna preverjanja tiskanja.</sys:String>
  <sys:String x:Key="Str_Installer_OptionalApp">Izbirna aplikacija MSI</sys:String>
  <sys:String x:Key="Str_Installer_FindApps">Poišči nameščene aplikacije MSI</sys:String>
  <sys:String x:Key="Str_Installer_ProductCode">Točna koda izdelka</sys:String>
  <sys:String x:Key="Str_Installer_Boundary">Za splošna preverjanja namestitvenega programa pustite prazno. Gumb Zaženi preveri izbrani izdelek. Samodejno popravilo ostane izklopljeno, dokler ga posebej ne omogočite, in je dovoljeno le za pravkar potrjeno okvarjeno registracijo.</sys:String>
  <sys:String x:Key="Str_Time_KeepSource">Ohrani nastavljeni vir</sys:String>
  <sys:String x:Key="Str_Time_DomainHierarchy">Hierarhija domene</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Strežniki NTP po meri</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Do osem imen gostiteljev ali naslovov IP strežnikov NTP, ločenih s presledki</sys:String>
  <sys:String x:Key="Str_Time_Apply">Uveljavi izbrani vir in sinhroniziraj (lahko spremeni uro)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Preveri prekinjeno spremembo časa</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Preveri zabeležene nastavitve brez ponovnega poskusa spremembe</sys:String>
  <sys:String x:Key="Str_Time_Boundary">Zaženi diagnostiko prikaže predogled sprememb vira, razen če je izbrano Uveljavi. Hierarhija domene je omejena na člana domene, ki ni krmilnik domene. Vsaka sprememba zahteva sveže preverjanje pravilnikov, vloge in povišanih pravic. Brez samodejne razveljavitve.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Najmanjše število dni od zadnje uporabe (samo pregled):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Preveri odvisnosti storitev in načrtovanih opravil</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Izberi profile po pregledu</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Predogled izbranih profilov</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Varnostno kopiraj in preveri profil</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Izberite natanko en pregledan profil. Za novo varnostno kopijo vnesite novo lokalno mapo NTFS, ki še ne obstaja. Za pregled obstoječe kopije izberite njeno mapo. KillerBench profila nikoli ne izbriše.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Prebrskaj</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">Nova lokalna mapa NTFS, ki še ne obstaja, za kopiranje ali obstoječa mapa kopiranega profila za preverjanje</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Kopiraj in preveri</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Enkrat kopiraj izbrani nenaloženi profil v novo prazno lokalno mapo NTFS, nato preveri vsako običajno datoteko</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Ustvari datoteke za preverjanje</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Primerja izbrani izvorni profil z obstoječo kopirano mapo, nato ustvari njen manifest in potrdilo</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Preveri kopirano varnostno kopijo</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Preveri obstoječi manifest in potrdilo glede na izvorni profil in kopirano mapo</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Preveri prekinjeno varnostno kopiranje</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Preveri nedokončano varnostno kopijo brez ponovnega kopiranja datotek</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">Preverjanje primerja celoten nabor običajnih datotek, njihove dolžine in zgoščene vrednosti SHA-256. Ne dokazuje pravilnosti dovoljenj, alternativnih tokov, šifriranih datotek, stanja aplikacij ali vedenja pri obnovitvi.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Izberite področja za pregled. Za odložišče in podprte nastavitve računa, vključno z dostopom do kamere in mikrofona, so na voljo ločeni zaščiteni kontrolniki.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Zgodovina odložišča</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Samo preglej</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Vklopi</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Izklopi</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Uveljavi, ko izberem Zaženi diagnostiko</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Orodja</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Nastavitev zasebnosti</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Dejanje</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Spremembe veljajo samo za ta račun. Ustrezni pravilniki, dostop do naprav za celoten računalnik, izjeme za posamezne aplikacije, diagnostično zbiranje in shranjena vsebina odložišča se ohranijo. Preverjeni dnevniki podpirajo zaščiteno razveljavitev.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">Zaženi diagnostiko privzeto samo pregleduje. Varnostno kopiranje, šifriranje in nadaljevanje zaščite zahtevajo vsako svojo ustrezno potrditev spodaj.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Nosilec</sys:String>
  <sys:String x:Key="Str_BitLocker_Operation">Opravilo</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Šifriranje</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Varnostna kopija za obnovitev</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Samo zasedeni prostor</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Datoteka varnostne kopije (za cilj Datoteka)</sys:String>
  <sys:String x:Key="Str_BitLocker_Browse">Prebrskaj...</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">Za varnostno kopijo v datoteki vnesite polno pot zunaj zaščitenega nosilca.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Poišči zaščitnike za obnovitev</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Zapiši izbrano varnostno kopijo za obnovitev, ko izberem Zaženi diagnostiko</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Varnostno kopiraj izbrani obnovitveni ključ in začni šifriranje, ko izberem Zaženi diagnostiko</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Nadaljuj zaščito tega v celoti šifriranega nosilca, ko izberem Zaženi diagnostiko</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">Šifriranje zahteva izbrani zaščitnik z obnovitvenim geslom in novo preverjeno datoteko varnostne kopije zunaj zaščitenega nosilca. Pogon Windows potrebuje tudi zaščitnik TPM. Obstoječi zaščitniki in upravljani pravilniki se ohranijo.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Več dejanj za BitLocker</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Dejanje</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Vklopi samodejno odklepanje</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Dodaj zaščitnik TPM</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Dodaj obnovitveno geslo</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Varnostno kopiraj obnovitveno geslo v Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Varnostno kopiraj obnovitveno geslo v Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Dešifriraj ta pogon</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Varnostne kopije uporabljajo zgoraj izbrani obnovitveni zaščitnik. Vsako dejanje neposredno pred izvedbo ponovi preverjanja in nikoli ne ponovi prekinjene zahteve.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Izvedi to spremembo na izbranem pogonu, ko pritisnem Izvedi dejanje</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Razumem, da pogon ne bo zaščiten</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Predogled</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Izvedi dejanje</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Diagnostični kanal</sys:String>
  <sys:String x:Key="Str_EventLog_System">System</sys:String>
  <sys:String x:Key="Str_EventLog_Application">Application</sys:String>
  <sys:String x:Key="Str_EventLog_Setup">Setup</sys:String>
  <sys:String x:Key="Str_EventLog_WindowsUpdate">Windows Update Client / Operational</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Omogoči ta kanal po ponovnem preverjanju</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">Gumb Zaženi vedno pregleda vse štiri kanale. Ta možnost spremeni samo točno izbrani onemogočeni, neupravljani kanal in preveri, ali so vse druge sporočene nastavitve kanalov ostale nespremenjene.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Poizvedba po imenu gostitelja (izbirno)</sys:String>
  <sys:String x:Key="Str_Network_Destination">Cilj TCP (izbirno)</sys:String>
  <sys:String x:Key="Str_Network_Port">Vrata TCP</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Časovna omejitev posamezne poizvedbe ali povezave (sekunde)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Za preizkus povezave vnesite cilj in vrata. Podatki aplikacij se ne pošiljajo.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">Pustite prazno, da preskočite. Uporabi nastavljeni razreševalnik; nastavitve DNS se ne spremenijo.</sys:String>
  <sys:String x:Key="Str_Audio_EndpointScope">Obseg privzetih končnih točk</sys:String>
  <sys:String x:Key="Str_Audio_InputOutput">Vhod in izhod</sys:String>
  <sys:String x:Key="Str_Audio_Output">Izhod</sys:String>
  <sys:String x:Key="Str_Audio_Input">Vhod</sys:String>
  <sys:String x:Key="Str_Audio_WindowsRole">Vloga v sistemu Windows</sys:String>
  <sys:String x:Key="Str_Audio_AllRoles">Vse vloge</sys:String>
  <sys:String x:Key="Str_Audio_Console">Konzola</sys:String>
  <sys:String x:Key="Str_Audio_Multimedia">Večpredstavnost</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Komunikacije</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">Gumb Zaženi še vedno preveri vse zvočne naprave in gonilnike. Ti kontrolniki omejijo prikazane podrobnosti privzetih končnih točk.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Pripravi eno obnovitveno točko</sys:String>
  <sys:String x:Key="Str_Restore_Description">Opis</sys:String>
  <sys:String x:Key="Str_Restore_DefaultDescription">Pred vzdrževanjem s KillerBench</sys:String>
  <sys:String x:Key="Str_Restore_Reason">Razlog</sys:String>
  <sys:String x:Key="Str_Restore_SystemSettings">Sprememba sistemskih nastavitev</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Namestitev aplikacije</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Namestitev gonilnika naprave</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">Gumb Zaženi izpiše obstoječe točke, razen če je izbrana ta možnost. Spodaj izberite samodejno dejanje, da po ponovnem preverjanju zahtevate eno točko. Omejitve pogostosti in pravilniki zaščite sistema Windows se ohranijo.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Nosilec za preverjanje</sys:String>
  <sys:String x:Key="Str_Storage_Description">Preveri ta nosilec NTFS ter diske in krmilnike v celotnem računalniku. Ugotovitve o napravah niso pripisane temu nosilcu. Popravilo ali ponovni zagon se ne načrtuje.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Preglej popravilo datotečnega sistema</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Ciljno popravilo</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Pregled in popravilo brez povezave</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">Dovoli odklop nesistemskega nosilca</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Pomembni podatki na tem nosilcu so varnostno kopirani</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analiziraj optimizacijo pogona</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Priporočilo sistema Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Ponovi TRIM za polprevodniško shrambo</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Defragmentiraj trdi disk</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">Gumb Zaženi vedno najprej zbere trenutne dokaze. Popravilo datotečnega sistema in optimizacija pogona sta ločeni možnosti. Optimizacija zahteva potrjeno vrsto nosilca in nikoli ne spremeni urnikov ali znova zažene sistema Windows.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">Gumb Zaženi preveri, ali Windows priporoča čiščenje. Izbirno čiščenje takoj odstrani nadomeščene komponente; brez samodejne razveljavitve ali ponovnega zagona. Sproščeni prostor se ne meri.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Preglej izbrano mapo</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Poiščite podvojene ali velike datoteke v eni izbrani lokalni mapi. Oba pregleda sta samo za branje in nikoli ne izbereta datotek za brisanje.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Prebrskaj</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Ena lokalna mapa. Točke vnovične razčlenitve in nedostopna vsebina so izključene.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Poišči dvojnike</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Pregled dvojnikov s SHA-256 samo za branje</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Poišči velike datoteke</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Pregled datotek velikosti vsaj 100 MB samo za branje</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Predlagano ime računalnika</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Po ponovnem preverjanju preimenuj ta računalnik v delovni skupini</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">Zaženi diagnostiko pregleda ime in trenutno identiteto. Če je izbrano preimenovanje, je upravičen samo samostojen računalnik v delovni skupini z izpolnjenimi pogoji. KillerBench nikoli znova ne zažene sistema Windows.</sys:String>
