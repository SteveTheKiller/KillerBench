  <sys:String x:Key="Str_Apps_CompareInventories">Gespeicherte Inventare vergleichen...</sys:String>
  <sys:String x:Key="Str_Apps_CompareInventoriesTip">Vorher- und Nachher-JSON-Dateien installierter Apps auswählen. Es werden keine Anwendungen geändert.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensions">Browsererweiterungen prüfen</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensionsTip">Liest Identitäten von Chrome-, Edge-, Brave- und Firefox-Erweiterungen. Kein Browser, keine Erweiterung und keine Richtlinie wird geändert.</sys:String>
  <sys:String x:Key="Str_Apps_FolderName">Exakter Anwendungsordnername</sys:String>
  <sys:String x:Key="Str_Apps_FolderNameTip">Nur ein Ordnername. Fünf feste Orte werden geprüft, ohne Inhalte zu lesen.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFolders">Ordner prüfen</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFoldersTip">Schreibgeschützte Prüfung von fünf exakten Anwendungsordnerorten. Keine Inhalte, Pfade oder Dateien werden angezeigt oder geändert.</sys:String>
