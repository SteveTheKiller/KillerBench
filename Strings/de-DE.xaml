  <sys:String x:Key="Str_Mace_Description">Genau auswählen, was geprüft werden soll. GO inventarisiert Registrierungen und zeigt Folgen an. Paketentfernung hat ein eigenes geschütztes Steuerelement.</sys:String>
  <sys:String x:Key="Str_Mace_FutureChoices">Künftige Entfernungsoptionen</sys:String>
