  <sys:String x:Key="Str_Apps_Description">Auswählen, welche Registrierungen gesammelt werden. Ausführendes Konto bedeutet das Konto, das KillerBench ausführt.</sys:String>
  <sys:String x:Key="Str_Apps_SaveInventory">Inventar speichern...</sys:String>
