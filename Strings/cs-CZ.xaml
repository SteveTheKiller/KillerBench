  <sys:String x:Key="Str_Mace_DestructiveRemoval">Destruktivní odstranění balíčku</sys:String>
  <sys:String x:Key="Str_Mace_RemovalConsent">Chápu, že toto odstraní pouze vybraný balíček po úspěšném prověření bezpečnostních opatření</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackage">ODEBRAT VYBRANÝ BALÍČEK</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackageTip">Vyžaduje způsobilé přezkoumání, toto potvrzení, druhé potvrzení a nové přesné důkazy před požádáním o odstranění.</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterrupted">Zkontrolovat přerušené odstranění</sys:String>
