  <sys:String x:Key="Str_Debloat_ActionTimers">Použít čtyři vybrané časovače napájení</sys:String>
  <sys:String x:Key="Str_Debloat_ActionDisableHibernation">Zakázat hibernaci</sys:String>
  <sys:String x:Key="Str_Debloat_Boundary">Změny napájení vyžadují, aby byla vybrána pouze odpovídající oblast. Spravovaná nastavení a uživatelská data zůstávají chráněna. Všechny ostatní oblasti jsou pouze ke kontrole.</sys:String>
  <sys:String x:Key="Str_Scope_ThisAccount">Tento účet</sys:String>
  <sys:String x:Key="Str_Bits_Description">Spustit diagnostiku čte úlohy přenosu. Všichni uživatelé vyžaduje přístup správce. Žádné přenosy se nemění.</sys:String>
  <sys:String x:Key="Str_Bits_Review">Prohlédnout vybraný přenos</sys:String>
  <sys:String x:Key="Str_Bits_Observe">Pozorovat vybraný přenos</sys:String>
  <sys:String x:Key="Str_Bits_ObserveTip">Porovnat dva snímky pět sekund od sebe. Žádné změny přenosu.</sys:String>
  <sys:String x:Key="Str_Bits_RetryWarning">Opakování může obnovit síťové přenosy vybrané úlohy. Nejprve zkontrolujte aplikaci, která ji vlastní. Pozastavené úlohy zůstanou zachovány; dokončení není zaručeno.</sys:String>
  <sys:String x:Key="Str_Bits_RetryAvailability">Shromážděte a vyberte úlohu spouštějícího účtu a zkontrolujte dostupnost opakování.</sys:String>
  <sys:String x:Key="Str_Bits_RetryConsent">Požádat o opakování této vybrané úlohy</sys:String>
  <sys:String x:Key="Str_Bits_Retry">Opakovat vybraný přenos</sys:String>
  <sys:String x:Key="Str_Print_FindPrinters">Najít místní tiskárny</sys:String>
  <sys:String x:Key="Str_Print_RepairDefault">Opravit chybějící nebo konfliktní výchozí tiskárnu pomocí této fronty</sys:String>
  <sys:String x:Key="Str_Print_FindBlockedJobs">Najít zablokované tiskové úlohy</sys:String>
  <sys:String x:Key="Str_Print_CancelSelected">Zrušit pouze tuto vybranou úlohu</sys:String>
  <sys:String x:Key="Str_Print_CheckInterrupted">Zkontrolovat přerušené rušení úlohy</sys:String>
  <sys:String x:Key="Str_Print_GeneralChecks">Použít obecné kontroly tisku</sys:String>
  <sys:String x:Key="Str_Print_Boundary">Tlačítko Spustit kontroluje vybranou frontu. Vybranou úlohu s chybou nebo zablokovanou lze zrušit jen po samostatném potvrzení. Každá jiná zjištěná úloha musí zůstat ve frontě. Výchozí oprava se omezuje na chybějící nebo konfliktní výchozí tiskárny. Bez výběru spustí obecné kontroly tisku.</sys:String>
  <sys:String x:Key="Str_Installer_OptionalApp">Volitelná MSI aplikace</sys:String>
  <sys:String x:Key="Str_Installer_FindApps">Najít nainstalované MSI aplikace</sys:String>
  <sys:String x:Key="Str_Installer_ProductCode">Přesný produktový kód</sys:String>
  <sys:String x:Key="Str_Installer_Boundary">Pro obecné kontroly Installeru ponechte prázdné. Tlačítko Spustit zkontroluje vybraný produkt. Automatická oprava zůstává vypnutá, pokud ji samostatně nezapnete, a způsobilá je jen nově potvrzená poškozená registrace.</sys:String>
  <sys:String x:Key="Str_Time_KeepSource">Zachovat nakonfigurovaný zdroj</sys:String>
  <sys:String x:Key="Str_Time_DomainHierarchy">Hierarchie domény</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Vlastní servery NTP</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Až osm názvů hostitelů NTP nebo IP adres oddělených mezerami</sys:String>
  <sys:String x:Key="Str_Time_Apply">Použít vybraný zdroj a synchronizovat (může změnit hodiny)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Zkontrolovat přerušenou změnu času</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Ověřit zaznamenaná nastavení bez opakování změny</sys:String>
  <sys:String x:Key="Str_Time_Boundary">Spustit diagnostiku zobrazí náhled změn zdroje, pokud není vybráno Použít. Hierarchie domény je omezena na člena domény, který není řadičem domény. Každá změna vyžaduje nové kontroly zásad, role a zvýšení oprávnění. Žádné automatické vrácení.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Minimální počet dní od posledního použití (pouze pro kontrolu):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Zkontrolovat závislosti služeb a naplánovaných úloh</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Vybrat profily po kontrole</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Náhled vybraných profilů</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Zálohovat a ověřit profil</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Vyberte přesně jeden zkontrolovaný profil. Chcete-li vytvořit novou zálohu, zadejte novou místní složku NTFS, která neexistuje. Chcete-li zkontrolovat existující kopii, vyberte její složku. KillerBench profil nikdy neodstraní.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Procházet</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">Nová chybějící místní složka NTFS pro kopírování, nebo existující zkopírovaná složka profilu pro ověření</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Kopírovat a ověřit</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Zkopírovat vybraný nenačtený profil jednou do nové prázdné místní složky NTFS a potom ověřit každý běžný soubor</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Vytvořit ověřovací soubory</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Porovnejte vybraný aktivní profil s existující zkopírovanou složkou, poté vytvořte jeho manifest a potvrzení</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Ověřit zkopírovanou zálohu</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Ověřit existující manifest a potvrzení vůči jak aktivnímu profilu, tak zkopírované složce</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Zkontrolovat přerušenou zálohu</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Ověřit čekající zálohu bez opětovného kopírování souborů</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">Ověření porovnává kompletní sadu běžných souborů, délky a SHA-256 hashe. Neprokazuje oprávnění, alternativní proudy, šifrované soubory, stav aplikace ani chování při obnovení.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Vyberte oblasti pro kontrolu. Samostatné chráněné ovládací prvky jsou k dispozici pro Schránku a podporovaná nastavení účtu, včetně přístupu ke kameře a mikrofonu.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Historie schránky</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Pouze kontrolovat</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Zapnout</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Vypnout</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Použít, když vyberu Spustit diagnostiku</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Nástroje</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Nastavení soukromí</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Akce</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Změny se týkají pouze tohoto účtu. Odpovídající zásady, přístup k zařízením pro celý počítač, výjimky pro jednotlivé aplikace, sběr diagnostických dat a uložený obsah schránky zůstanou zachovány. Ověřené deníky podporují chráněné vrácení zpět.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">Spustit diagnostiku ve výchozím nastavení pouze kontroluje. Záloha, šifrování a obnovení ochrany vyžadují každé odpovídající potvrzení níže.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Svazek</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Šifrování</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Záloha pro obnovení</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Pouze použitý prostor</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Záložní soubor (pro cíl Soubor)</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">Pro zálohování souborů zadejte úplnou cestu mimo chráněný svazek.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Najít ochrany pro obnovení</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Zapsat vybranou zálohu pro obnovení, když vyberu Spustit diagnostiku</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Zálohovat vybraný klíč pro obnovení a potom zahájit šifrování, když vyberu Spustit diagnostiku</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Obnovit ochranu na tomto plně zašifrovaném svazku, když vyberu Spustit diagnostiku</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">Šifrování vyžaduje vybranou ochranu heslem pro obnovení a nový ověřený záložní soubor mimo chráněný svazek. Jednotka Windows navíc potřebuje svou ochranu TPM. Stávající ochrany a spravované zásady zůstanou zachovány.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Další akce nástroje BitLocker</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Akce</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Zapnout automatické odemykání</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Přidat ochranu TPM</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Přidat heslo pro obnovení</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Zálohovat heslo pro obnovení do služby Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Zálohovat heslo pro obnovení do Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Dešifrovat tuto jednotku</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Zálohy používají ochranu pro obnovení vybranou výše. Každá akce těsně před spuštěním zopakuje kontroly a nikdy nezopakuje přerušený požadavek.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Provést tuto změnu na vybrané jednotce, když stisknu Spustit akci</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Rozumím, že jednotka nebude chráněna</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Náhled</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Spustit akci</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Diagnostický kanál</sys:String>
  <sys:String x:Key="Str_EventLog_Setup">Instalace</sys:String>
  <sys:String x:Key="Str_EventLog_WindowsUpdate">Klient služby Windows Update / Provozní</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Povolit tento kanál po nových kontrolách</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">Tlačítko Spustit vždy kontroluje všechny čtyři kanály. Tato možnost mění jen přesně vybraný zakázaný a nespravovaný kanál a ověřuje, že všechna ostatní ohlášená nastavení kanálů zůstala beze změny.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Vyhledávání názvu hostitele (volitelné)</sys:String>
  <sys:String x:Key="Str_Network_Destination">Cíl TCP (volitelné)</sys:String>
  <sys:String x:Key="Str_Network_Port">Port TCP</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Časový limit na vyhledávání nebo připojení (sekundy)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Zadejte jak cíl, tak port pro otestování připojení. Nejsou odesílána žádná aplikační data.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">Nechte prázdné pro přeskočení. Použije se váš nakonfigurovaný resolver; žádná nastavení DNS nejsou změněna.</sys:String>
  <sys:String x:Key="Str_Audio_EndpointScope">Výchozí rozsah koncového bodu</sys:String>
  <sys:String x:Key="Str_Audio_InputOutput">Vstup a výstup</sys:String>
  <sys:String x:Key="Str_Audio_Input">Vstup</sys:String>
  <sys:String x:Key="Str_Audio_WindowsRole">Role Windows</sys:String>
  <sys:String x:Key="Str_Audio_AllRoles">Všechny role</sys:String>
  <sys:String x:Key="Str_Audio_Console">Konzole</sys:String>
  <sys:String x:Key="Str_Audio_Multimedia">Multimédia</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Komunikace</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">Tlačítko Spustit stále kontroluje každé zvukové zařízení a ovladač. Tyto ovládací prvky omezují jen zobrazené podrobnosti výchozího koncového bodu.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Připravit jeden bod obnovení</sys:String>
  <sys:String x:Key="Str_Restore_DefaultDescription">Před údržbou KillerBench</sys:String>
  <sys:String x:Key="Str_Restore_Reason">Důvod</sys:String>
  <sys:String x:Key="Str_Restore_SystemSettings">Změna nastavení systému</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Instalace aplikace</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Instalace ovladače zařízení</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">Tlačítko Spustit vypíše existující body, pokud není vybrána tato možnost. Vyberte níže automatickou akci pro vyžádání jednoho bodu po nových kontrolách. Limity četnosti a zásady ochrany Windows zůstanou zachovány.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Svazek ke kontrole</sys:String>
  <sys:String x:Key="Str_Storage_Description">Kontroluje tento svazek NTFS a disková a řadičová zařízení v celém počítači. Zjištění o zařízeních nejsou přiřazena k tomuto svazku. Žádná oprava ani restart se neplánuje.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Zkontrolovat opravu souborového systému</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Rychlá oprava</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Offline sken a oprava</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">Povolit odpojení nesystémového svazku</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Důležitá data na tomto svazku jsou zálohována</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analyzovat optimalizaci disku</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Doporučeno systémem Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Retrim paměti SSD</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Defragmentovat pevný disk</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">Tlačítko Spustit vždy nejprve shromáždí aktuální důkazy. Oprava systému souborů a optimalizace jednotky jsou samostatné volby. Optimalizace vyžaduje potvrzený typ média a nikdy nemění plány ani nerestartuje Windows.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">Tlačítko Spustit zkontroluje, zda Windows doporučuje vyčištění. Volitelné vyčištění okamžitě odstraní nahrazené komponenty; bez automatického vrácení a restartu. Uvolněné místo se neměří.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Zkontrolovat vybranou složku</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Najděte duplicitní soubory nebo velké soubory v jedné vybrané místní složce. Obě kontroly jsou pouze pro čtení a nikdy nevybírají soubory k odstranění.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Procházet</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Jedna místní složka. Body rozboru a nepřístupný obsah jsou vyloučeny.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Najít duplicity</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Kontrola SHA-256 duplicit pouze pro čtení</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Najít velké soubory</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Kontrola pouze pro čtení pro soubory o velikosti alespoň 100 MB</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Navrhovaný název počítače</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Přejmenovat tento počítač v pracovní skupině po nových kontrolách</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">Spustit diagnostiku zkontroluje název a aktuální identitu. Při vybrané možnosti přejmenování je způsobilý jen samostatný počítač v pracovní skupině se splněnými předpoklady. KillerBench nikdy nerestartuje Windows.</sys:String>
