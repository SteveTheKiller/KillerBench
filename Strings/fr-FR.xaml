  <sys:String x:Key="Str_Task_StartDate">Date de début XML (YYYY-MM-DD)</sys:String>
  <sys:String x:Key="Str_Task_StartDateTip">Limite de début du calendrier local; les déclencheurs de démarrage n&apos;utilisent pas cette date</sys:String>
