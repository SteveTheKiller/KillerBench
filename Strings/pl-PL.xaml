  <sys:String x:Key="Str_Packages_IncludeProvisionedTip">Odczytuje także pakiety przygotowane w obrazie Windows. Wymaga dostępu administratora.</sys:String>
  <sys:String x:Key="Str_Packages_ReviewSelected">Przejrzyj wybrany pakiet</sys:String>
  <sys:String x:Key="Str_Apps_Description">Wybierz, które rejestracje zbierać. Konto uruchamiające oznacza konto wykonujące KillerBench.</sys:String>
  <sys:String x:Key="Str_Apps_SaveInventory">Zapisz inwentarz...</sys:String>
  <sys:String x:Key="Str_Apps_SaveInventoryTip">Zapisz rejestracje z ostatniego zakończonego zbierania, wraz z limitami pokrycia.</sys:String>
  <sys:String x:Key="Str_Apps_CompareInventories">Porównaj zapisane inwentarze...</sys:String>
  <sys:String x:Key="Str_Apps_CompareInventoriesTip">Wybierz pliki JSON z zainstalowanymi aplikacjami przed i po. Żadne aplikacje nie są zmieniane.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensions">Przejrzyj rozszerzenia przeglądarki</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensionsTip">Odczytaj tożsamości rozszerzeń Chrome, Edge, Brave i Firefox. Żadna przeglądarka, rozszerzenie ani zasada nie jest zmieniana.</sys:String>
  <sys:String x:Key="Str_Apps_FolderName">Dokładna nazwa folderu aplikacji</sys:String>
  <sys:String x:Key="Str_Apps_FolderNameTip">Tylko jedna nazwa folderu. Pięć stałych lokalizacji jest sprawdzanych bez odczytu zawartości.</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFolders">Przejrzyj foldery</sys:String>
  <sys:String x:Key="Str_Apps_ReviewFoldersTip">Przegląd tylko do odczytu pięciu dokładnych lokalizacji folderów aplikacji. Zawartość, ścieżki ani pliki nie są pokazywane ani zmieniane.</sys:String>
  <sys:String x:Key="Str_Scope_AllUsersAndNew">Wszyscy użytkownicy i nowi użytkownicy</sys:String>
  <sys:String x:Key="Str_Common_Applications">Aplikacje</sys:String>
  <sys:String x:Key="Str_Common_Both">Oba</sys:String>
  <sys:String x:Key="Str_Mace_Description">Wybierz dokładnie, co przejrzeć. Uruchom diagnozę inwentaryzuje rejestracje i pokazuje skutki. Usuwanie pakietów ma własną chronioną kontrolkę.</sys:String>
  <sys:String x:Key="Str_Mace_FutureChoices">Przyszłe wybory usuwania</sys:String>
  <sys:String x:Key="Str_Mace_RemoveData">Usuń dane profilu wybranych aplikacji</sys:String>
  <sys:String x:Key="Str_Mace_RemoveCredentials">Usuń buforowane poświadczenia wybranych aplikacji</sys:String>
  <sys:String x:Key="Str_Mace_RestoreFolders">Przejrzyj lokalizacje folderów OneDrive do przywrócenia</sys:String>
  <sys:String x:Key="Str_Mace_ReviewBoundary">Uruchom diagnozę zapisuje te wybory tylko w przeglądzie. Żaden proces, aplikacja, pakiet, plik, poświadczenie, lokalizacja folderu, wartość rejestru ani dane użytkownika nie są zmieniane.</sys:String>
  <sys:String x:Key="Str_Mace_PackagePlan">Obsługiwany plan pakietu</sys:String>
  <sys:String x:Key="Str_Mace_CheckPackage">Sprawdź wybrany pakiet</sys:String>
  <sys:String x:Key="Str_Mace_PackageHint">Wybierz Uruchom diagnozę, aby znaleźć obsługiwane pakiety kandydujące bieżącego konta.</sys:String>
  <sys:String x:Key="Str_Mace_DestructiveRemoval">Destrukcyjne usuwanie pakietu</sys:String>
  <sys:String x:Key="Str_Mace_RemovalConsent">Rozumiem, że usuwa to tylko wybrany pakiet po przejściu świeżych zabezpieczeń</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackage">USUŃ WYBRANY PAKIET</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackageTip">Wymaga kwalifikującego przeglądu, tego potwierdzenia, drugiego potwierdzenia i świeżych dokładnych dowodów przed żądaniem usunięcia.</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterrupted">Sprawdź przerwane usuwanie</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterruptedTip">Sprawdza wcześniejszy rekord usuwania pakietu bez wysyłania kolejnego żądania usunięcia.</sys:String>
  <sys:String x:Key="Str_Mace_RemovalBoundary">Ta czerwona kontrolka jest oddzielona od Uruchom diagnozę. Usuwa jeden dokładny, niechroniony pakiet deweloperski tylko dla konta uruchamiającego. Końcowe żądanie jest zapisywane i nigdy nie jest ponawiane automatycznie.</sys:String>
  <sys:String x:Key="Str_Orca_Description">Wybierz wersję Outlooka, zakres konta i dokładne obszary resetu. Przycisk Uruchom je przegląda. Tylko dla pamięci podręcznych konta uruchamiającego włącz zachowanie, aby przenieść je pod nazwy odzyskiwania po świeżych kontrolach.</sys:String>
  <sys:String x:Key="Str_Orca_NewOutlook">Nowy Outlook</sys:String>
  <sys:String x:Key="Str_Orca_ClassicOutlook">Klasyczny Outlook</sys:String>
  <sys:String x:Key="Str_Orca_ResetAreas">Obszary resetowania</sys:String>
  <sys:String x:Key="Str_Orca_Caches">Pamięci podręczne Outlook</sys:String>
  <sys:String x:Key="Str_Orca_Profiles">Ustawienia profilu i odnajdywania</sys:String>
  <sys:String x:Key="Str_Orca_Authentication">Stan uwierzytelniania</sys:String>
  <sys:String x:Key="Str_Orca_OstFiles">Pliki OST klasycznego Outlook</sys:String>
  <sys:String x:Key="Str_Orca_AddIns">Dodatki klasycznego Outlook</sys:String>
  <sys:String x:Key="Str_Orca_ReinstallNew">Zainstaluj ponownie Nowy Outlook</sys:String>
  <sys:String x:Key="Str_Orca_Boundary">Dostępne jest tylko zachowanie pamięci podręcznej. Profile, pliki OST, poświadczenia, dodatki, pakiety, ustawienia i zachowane pamięci podręczne nigdy nie są usuwane.</sys:String>
  <sys:String x:Key="Str_Common_Configuration">Konfiguracja</sys:String>
