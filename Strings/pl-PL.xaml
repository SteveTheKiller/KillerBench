  <sys:String x:Key="Str_Update_AcceptAgreements">Zaakceptuj wybrane umowy pakietu i źródła</sys:String>
  <sys:String x:Key="Str_Update_ThirdPartyBoundary">Jedna dokładna paczka, źródło i wersja na operację. Brak automatycznego ponownego uruchomienia.</sys:String>
