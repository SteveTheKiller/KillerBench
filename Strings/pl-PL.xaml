  <sys:String x:Key="Str_Bits_Observe">Obserwuj wybrany transfer</sys:String>
  <sys:String x:Key="Str_Bits_ObserveTip">Porównaj dwie migawki w odstępie pięciu sekund. Żadne transfery nie są zmieniane.</sys:String>
  <sys:String x:Key="Str_Bits_RetryWarning">Ponowienie może wznowić transfery sieciowe dla wybranego zadania. Najpierw przejrzyj aplikację właściciela. Wstrzymane zadania są zachowywane; ukończenie nie jest gwarantowane.</sys:String>
  <sys:String x:Key="Str_Bits_RetryAvailability">Zbierz i wybierz zadanie konta uruchamiającego, aby przejrzeć dostępność ponowienia.</sys:String>
  <sys:String x:Key="Str_Bits_RetryConsent">Zażądaj ponowienia dla tego wybranego zadania</sys:String>
  <sys:String x:Key="Str_Bits_Retry">Ponów wybrany transfer</sys:String>
  <sys:String x:Key="Str_Print_FindPrinters">Znajdź drukarki lokalne</sys:String>
  <sys:String x:Key="Str_Print_RepairDefault">Napraw brakującą lub konfliktową domyślną drukarkę tą kolejką</sys:String>
  <sys:String x:Key="Str_Print_FindBlockedJobs">Znajdź zablokowane zadania drukowania</sys:String>
  <sys:String x:Key="Str_Print_CancelSelected">Anuluj tylko to wybrane zadanie</sys:String>
  <sys:String x:Key="Str_Print_CheckInterrupted">Sprawdź przerwane anulowanie zadania</sys:String>
  <sys:String x:Key="Str_Print_GeneralChecks">Użyj ogólnych kontroli drukowania</sys:String>
  <sys:String x:Key="Str_Print_Boundary">Przycisk Uruchom sprawdza wybraną kolejkę. Wybrane zadanie z błędem lub zablokowane można anulować tylko po osobnym potwierdzeniu. Każde inne zaobserwowane zadanie musi pozostać w kolejce. Domyślna naprawa ogranicza się do brakujących lub sprzecznych drukarek domyślnych. Bez wyboru uruchamia ogólne kontrole drukowania.</sys:String>
  <sys:String x:Key="Str_Installer_OptionalApp">Opcjonalna aplikacja MSI</sys:String>
  <sys:String x:Key="Str_Installer_FindApps">Znajdź zainstalowane aplikacje MSI</sys:String>
  <sys:String x:Key="Str_Installer_ProductCode">Dokładny kod produktu</sys:String>
  <sys:String x:Key="Str_Installer_Boundary">Pozostaw puste dla ogólnych kontroli Instalatora. Przycisk Uruchom sprawdza wybrany produkt. Automatyczna naprawa pozostaje wyłączona, chyba że włączysz ją osobno, a kwalifikuje się tylko świeżo potwierdzona uszkodzona rejestracja.</sys:String>
  <sys:String x:Key="Str_Time_KeepSource">Zachowaj skonfigurowane źródło</sys:String>
  <sys:String x:Key="Str_Time_DomainHierarchy">Hierarchia domeny</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Niestandardowe peery NTP</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Do ośmiu nazw hostów lub adresów IP NTP, oddzielonych spacjami</sys:String>
  <sys:String x:Key="Str_Time_Apply">Zastosuj wybrane źródło i zsynchronizuj (może zmienić zegar)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Sprawdź przerwaną zmianę czasu</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Zweryfikuj zapisane ustawienia bez ponawiania zmiany</sys:String>
  <sys:String x:Key="Str_Time_Boundary">Uruchom diagnozę pokazuje podgląd zmian źródła, chyba że wybrano Zastosuj. Hierarchia domeny jest ograniczona do członka domeny, który nie jest kontrolerem domeny. Każda zmiana wymaga świeżych kontroli zasad, roli i podniesienia uprawnień. Brak automatycznego wycofania.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Minimalna liczba dni od ostatniego użycia (tylko przegląd):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Sprawdź zależności usług i zaplanowanych zadań</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Wybierz profile po przeglądzie</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Podgląd wybranych profili</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Utwórz kopię zapasową profilu i zweryfikuj</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Wybierz dokładnie jeden przejrzany profil. Aby utworzyć nową kopię zapasową, wpisz nowy lokalny folder NTFS, który nie istnieje. Aby sprawdzić istniejącą kopię, wybierz jej folder. KillerBench nigdy nie usuwa profilu.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Przeglądaj</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">Nowy nieistniejący lokalny folder NTFS do kopiowania albo istniejący folder skopiowanego profilu do weryfikacji</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Kopiuj i zweryfikuj</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Skopiuj wybrany niezaładowany profil raz do nowego pustego lokalnego folderu NTFS, a następnie zweryfikuj każdy zwykły plik</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Utwórz pliki weryfikacyjne</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Porównaj wybrany profil aktywny z istniejącym skopiowanym folderem, a następnie utwórz jego manifest i potwierdzenie</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Zweryfikuj skopiowaną kopię zapasową</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Zweryfikuj istniejący manifest i potwierdzenie względem profilu aktywnego i skopiowanego folderu</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Sprawdź przerwaną kopię zapasową</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Zweryfikuj oczekującą kopię zapasową bez ponownego kopiowania plików</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">Weryfikacja porównuje kompletny zestaw zwykłych plików, długości i skróty SHA-256. Nie potwierdza uprawnień, alternatywnych strumieni, zaszyfrowanych plików, stanu aplikacji ani zachowania przywracania.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Wybierz obszary do sprawdzenia. Osobne chronione kontrolki są dostępne dla schowka i obsługiwanych ustawień konta, w tym dostępu do kamery i mikrofonu.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Historia schowka</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Tylko sprawdź</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Włącz</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Wyłącz</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Zastosuj, gdy wybiorę Uruchom diagnozę</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Narzędzia</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Ustawienie prywatności</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Akcja</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Zmiany dotyczą tylko tego konta. Pasujące zasady, dostęp urządzenia dla całego komputera, wyjątki poszczególnych aplikacji, zbieranie diagnostyki i zapisana zawartość schowka są zachowane. Zweryfikowane dzienniki obsługują chronione cofnięcie.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">Domyślnie Uruchom diagnozę tylko sprawdza. Kopia zapasowa, szyfrowanie i wznowienie ochrony wymagają każde odpowiedniego potwierdzenia poniżej.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Wolumin</sys:String>
  <sys:String x:Key="Str_BitLocker_Operation">Operacja</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Szyfrowanie</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Kopia zapasowa odzyskiwania</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Tylko użyte miejsce</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Plik kopii zapasowej (dla miejsca docelowego Plik)</sys:String>
  <sys:String x:Key="Str_BitLocker_Browse">Przeglądaj...</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">Dla kopii zapasowej do pliku podaj pełną ścieżkę poza chronionym woluminem.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Znajdź protektory odzyskiwania</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Zapisz wybraną kopię odzyskiwania, gdy wybiorę Uruchom diagnozę</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Utwórz kopię wybranego klucza odzyskiwania, a następnie rozpocznij szyfrowanie, gdy wybiorę Uruchom diagnozę</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Wznów ochronę na tym w pełni zaszyfrowanym woluminie, gdy wybiorę Uruchom diagnozę</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">Szyfrowanie wymaga wybranej funkcji ochrony hasłem odzyskiwania i nowego zweryfikowanego pliku kopii poza chronionym woluminem. Dysk systemu Windows potrzebuje też funkcji ochrony TPM. Istniejące funkcje ochrony i zasady zarządzane pozostają bez zmian.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Więcej akcji funkcji BitLocker</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Akcja</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Włącz automatyczne odblokowywanie</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Dodaj funkcję ochrony TPM</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Dodaj hasło odzyskiwania</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Zapisz hasło odzyskiwania w usłudze Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Zapisz hasło odzyskiwania w usłudze Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Odszyfruj ten dysk</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Kopie używają wybranej powyżej funkcji ochrony odzyskiwania. Każda akcja powtarza sprawdzenia tuż przed uruchomieniem i nigdy nie powtarza przerwanego żądania.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Wprowadź tę zmianę na wybranym dysku po naciśnięciu Uruchom akcję</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Rozumiem, że dysk nie będzie chroniony</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Podgląd</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Uruchom akcję</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Kanał diagnostyczny</sys:String>
  <sys:String x:Key="Str_EventLog_System">System</sys:String>
  <sys:String x:Key="Str_EventLog_Application">Aplikacja</sys:String>
  <sys:String x:Key="Str_EventLog_Setup">Setup</sys:String>
  <sys:String x:Key="Str_EventLog_WindowsUpdate">Windows Update Client / Operational</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Włącz ten kanał po świeżych kontrolach</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">Przycisk Uruchom zawsze sprawdza wszystkie cztery kanały. Ta opcja zmienia tylko dokładnie wybrany, wyłączony i niezarządzany kanał oraz weryfikuje, że każde inne zgłoszone ustawienie kanału pozostało bez zmian.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Wyszukiwanie nazwy hosta (opcjonalne)</sys:String>
  <sys:String x:Key="Str_Network_Destination">Cel TCP (opcjonalny)</sys:String>
  <sys:String x:Key="Str_Network_Port">Port TCP</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Limit czasu na wyszukiwanie lub połączenie (sekundy)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Wpisz cel i port, aby przetestować połączenie. Żadne dane aplikacji nie są wysyłane.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">Pozostaw puste, aby pominąć. Używa skonfigurowanego resolvera; ustawienia DNS nie są zmieniane.</sys:String>
  <sys:String x:Key="Str_Audio_EndpointScope">Zakres domyślnego punktu końcowego</sys:String>
  <sys:String x:Key="Str_Audio_InputOutput">Wejście i wyjście</sys:String>
  <sys:String x:Key="Str_Audio_Output">Wyjście</sys:String>
  <sys:String x:Key="Str_Audio_Input">Wejście</sys:String>
  <sys:String x:Key="Str_Audio_WindowsRole">Rola Windows</sys:String>
  <sys:String x:Key="Str_Audio_AllRoles">Wszystkie role</sys:String>
  <sys:String x:Key="Str_Audio_Console">Konsola</sys:String>
  <sys:String x:Key="Str_Audio_Multimedia">Multimedia</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Komunikacja</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">Przycisk Uruchom nadal sprawdza każde urządzenie i sterownik audio. Te kontrolki ograniczają tylko wyświetlane szczegóły domyślnego punktu końcowego.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Przygotuj jeden punkt przywracania</sys:String>
  <sys:String x:Key="Str_Restore_Description">OPIS</sys:String>
  <sys:String x:Key="Str_Restore_DefaultDescription">Przed konserwacją KillerBench</sys:String>
  <sys:String x:Key="Str_Restore_Reason">Powód</sys:String>
  <sys:String x:Key="Str_Restore_SystemSettings">Zmiana ustawień systemu</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Instalacja aplikacji</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Instalacja sterownika urządzenia</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">Przycisk Uruchom wyświetla istniejące punkty, chyba że wybrano tę opcję. Wybierz akcję automatyczną poniżej, aby zażądać jednego punktu po świeżych kontrolach. Limity częstotliwości i zasady ochrony systemu Windows są zachowywane.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Wolumin do sprawdzenia</sys:String>
  <sys:String x:Key="Str_Storage_Description">Sprawdza ten wolumin NTFS oraz dyski i urządzenia kontrolerów w całym komputerze. Ustalenia urządzeń nie są mapowane na ten wolumin. Żadna naprawa ani ponowne uruchomienie nie jest planowane.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Przejrzyj naprawę systemu plików</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Naprawa punktowa</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Skanowanie i naprawa offline</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">Zezwól na odłączenie woluminu niesystemowego</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Ważne dane na tym woluminie mają kopię zapasową</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analizuj optymalizację dysku</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Zalecane przez Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Retrim nośnika półprzewodnikowego</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Defragmentuj dysk twardy</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">Przycisk Uruchom zawsze najpierw zbiera bieżące dowody. Naprawa systemu plików i optymalizacja dysku to osobne opcje. Optymalizacja wymaga potwierdzonego typu nośnika i nigdy nie zmienia harmonogramów ani nie uruchamia ponownie systemu Windows.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">Przycisk Uruchom sprawdza, czy system Windows zaleca czyszczenie. Opcjonalne czyszczenie od razu usuwa zastąpione składniki; bez automatycznego cofania i ponownego uruchomienia. Odzyskane miejsce nie jest mierzone.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Przejrzyj wybrany folder</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Znajdź duplikaty plików lub duże pliki w jednym wybranym folderze lokalnym. Oba przeglądy są tylko do odczytu i nigdy nie wybierają plików do usunięcia.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Przeglądaj</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Jeden folder lokalny. Punkty ponownej analizy i niedostępna zawartość są wykluczone.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Znajdź duplikaty</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Przegląd duplikatów SHA-256 tylko do odczytu</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Znajdź duże pliki</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Przegląd tylko do odczytu dla plików co najmniej 100 MB</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Proponowana nazwa komputera</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Zmień nazwę tego komputera grupy roboczej po świeżych kontrolach</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">Uruchom diagnozę przegląda nazwę i bieżącą tożsamość. Przy wybranej opcji zmiany nazwy kwalifikuje się tylko samodzielny komputer w grupie roboczej ze spełnionymi wymaganiami. KillerBench nigdy nie uruchamia ponownie systemu Windows.</sys:String>
  <sys:String x:Key="Str_Main_AutoRepair">Automatycznie napraw potwierdzone problemy</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosis">Uruchom diagnozę</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosisTip">Uruchom wybrane kontrole tylko do odczytu i otwórz czytelny raport.</sys:String>
  <sys:String x:Key="Str_Main_Stop">Zatrzymaj</sys:String>
  <sys:String x:Key="Str_Main_StopTip">Zatrzymaj po bieżącym poleceniu (Esc)</sys:String>
