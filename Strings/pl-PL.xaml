  <sys:String x:Key="Str_Guidance_Restart">Uruchom ponownie komputer w dogodnym momencie, a następnie ponów ten przepływ, aby zweryfikować wynik i kontynuować.</sys:String>
  <sys:String x:Key="Str_Guidance_Interrupted">Przed kolejną naprawą przejrzyj zapisany dziennik. Poprzednia operacja może być niekompletna.</sys:String>
  <sys:String x:Key="Str_Guidance_AdminCli">Otwórz terminal administratora i ponów ten przepływ, aby ukończyć jego kontrole.</sys:String>
  <sys:String x:Key="Str_Guidance_Admin">Uruchom KillerBench jako administrator, wybierz tę kontrolę i ponownie wybierz Uruchom diagnostykę.</sys:String>
  <sys:String x:Key="Str_Guidance_ReviewBeforeRepairs">Przejrzyj nowe wyniki przed włączeniem napraw.</sys:String>
  <sys:String x:Key="Str_Guidance_ChecksOnly">Ten przepływ wykonuje tylko kontrole. Nie wybrano naprawy ani usuwania.</sys:String>
  <sys:String x:Key="Str_Guidance_ExactRepair">Wybierz dokładny cel naprawy i wymagane opcje, przejrzyj skutki, a następnie potwierdź tę konkretną naprawę. Ogólny przełącznik automatycznej naprawy jej nie uruchomi.</sys:String>
  <sys:String x:Key="Str_Guidance_AutoCli">Ponów ten przepływ z --auto-repair, aby uruchomić kwalifikujące się naprawy.</sys:String>
  <sys:String x:Key="Str_Guidance_Cleanup">Wybierz Uruchom zalecane czyszczenie, a następnie Uruchom naprawę, aby wykonać zalecaną konserwację.</sys:String>
  <sys:String x:Key="Str_Guidance_Auto">Wybierz Automatycznie napraw potwierdzone problemy, a następnie Uruchom naprawę, aby wykonać kwalifikujące się naprawy.</sys:String>
  <sys:String x:Key="Str_Guidance_DeviceAttention">Sprawdź zgłoszony identyfikator urządzenia i kod konfiguracji w Menedżerze urządzeń. Użyj identyfikatorów sprzętu, aby znaleźć zatwierdzony sterownik producenta. Sam kod nie dowodzi awarii sprzętu.</sys:String>
  <sys:String x:Key="Str_Guidance_DeviceIncomplete">Dowody dotyczące urządzeń są niepełne. Rozwiąż zgłoszony problem zbierania danych i ponów kontrolę, zanim zdecydujesz, czy sterownik lub urządzenie wymaga uwagi.</sys:String>
  <sys:String x:Key="Str_Guidance_DeviceClear">Zebrane dowody nie wskazały aktywnej usterki urządzenia wymagającej uwagi. Sprawdź brakujące urządzenia i bezpośrednio przetestuj sprzęt. Niewykryte urządzenia pozostają poza tym zrzutem stanu.</sys:String>
  <sys:String x:Key="Str_Guidance_DeviceNoChange">Nie włączono ani nie zresetowano urządzeń i nie zmieniono ich sterowników.</sys:String>
  <sys:String x:Key="Str_Guidance_InputAttention">Użyj zgłoszonej nazwy, identyfikatora i kodu urządzenia, aby sprawdzić połączenie i zatwierdzony sterownik w Menedżerze urządzeń. Brak danych inwentaryzacji sterowników nie dowodzi braku sterownika.</sys:String>
  <sys:String x:Key="Str_Guidance_InputClear">Nie zgłoszono błędu konfiguracji w zebranych zakresach. Bezpośrednio przetestuj klawiaturę, mysz lub funkcję HID.</sys:String>
  <sys:String x:Key="Str_Guidance_InputNoChange">Nie przechwycono danych wejściowych, nie zresetowano urządzeń ani nie zmieniono sterowników.</sys:String>
  <sys:String x:Key="Str_Guidance_DefenderAttention">Przejrzyj każdą oznaczoną kontrolkę Defender w Zabezpieczeniach Windows i porównaj ją z docelową polityką zabezpieczeń punktu końcowego. Przed zmianami potwierdź aktywny produkt zabezpieczeń i właściciela polityki.</sys:String>
  <sys:String x:Key="Str_Guidance_DefenderClear">Żadna kontrolka Defender w tym przeglądzie nie wymaga natychmiastowej uwagi. Porównaj zachowane ustawienia z docelową polityką zabezpieczeń punktu końcowego.</sys:String>
  <sys:String x:Key="Str_Guidance_DefenderNoChange">Nie zmieniono skanowania, usuwania zagrożeń, wykluczeń, polityki ani ustawień zabezpieczeń.</sys:String>
  <sys:String x:Key="Str_Guidance_Findings">Przejrzyj nierozwiązane ustalenia poniżej. Nie wybrano automatycznie szerszej naprawy.</sys:String>
  <sys:String x:Key="Str_Guidance_Updates">Przejrzyj zwróconą listę aktualizacji. Ten przepływ wykrywania nie włącza instalacji.</sys:String>
  <sys:String x:Key="Str_Guidance_CleanupPreview">Przejrzyj oszacowanie przed wyborem trwałego usuwania. Podgląd nie usunął plików.</sys:String>
  <sys:String x:Key="Str_Guidance_Privacy">Przejrzyj wybrane zrzuty ustawień prywatności. Zapisane wartości nie dowodzą rzeczywistych uprawnień. Nie zmieniono ustawień prywatności.</sys:String>
  <sys:String x:Key="Str_Guidance_BitLocker">Przejrzyj wybrany wolumin i opcje kopii zapasowej. Kontrola nie skopiowała kluczy ani nie zmieniła szyfrowania.</sys:String>
  <sys:String x:Key="Str_Guidance_Profiles">Przejrzyj wiek profili i wykluczenia. Sam wiek nie zezwala na usunięcie. Przed przyszłym usunięciem sprawdź kopie zapasowe i zależności kont.</sys:String>
  <sys:String x:Key="Str_Guidance_ComputerName">Przejrzyj proponowaną nazwę i uwagi o środowisku. Przed planowaniem zmiany potwierdź zasady nazewnictwa organizacji, dostępność nazwy i zależności aplikacji. Ten przegląd niczego nie zmienił.</sys:String>
  <sys:String x:Key="Str_Guidance_Component">Przejrzyj zalecenie dotyczące magazynu składników poniżej. Nie zmierzono odzyskanego miejsca.</sys:String>
  <sys:String x:Key="Str_Guidance_Foxit">Przejrzyj pasujące wpisy rejestru komputera. Inwentaryzacja nie sprawdza zainstalowanych plików wykonywalnych, instalacji użytkowników ani polityki aktualizacji. Nie zmieniono ustawień Foxit.</sys:String>
  <sys:String x:Key="Str_Guidance_Tasks">Przejrzyj pełne ścieżki zadań i zgłoszone konta wykonania. Inwentaryzacja nie sprawdza akcji, wyzwalaczy, uprawnień ani powodzenia wykonania. Nie uruchomiono ani nie zmieniono zadań.</sys:String>
  <sys:String x:Key="Str_Guidance_Finished">Wybrane kontrole zakończyły się. Przetestuj daną funkcję, aby potwierdzić prawidłowe działanie.</sys:String>
  <sys:String x:Key="Str_Guidance_Wait">Ten przepływ nadal działa. Poczekaj na końcowy wynik przed planowaniem kolejnej naprawy.</sys:String>
  <sys:String x:Key="Str_Guidance_Timeout">Polecenie przekroczyło limit czasu. Potwierdź zakończenie poprzedniej pracy i ponów kontrole przed wyborem kolejnej naprawy.</sys:String>
  <sys:String x:Key="Str_Guidance_Incomplete">Niektóre kontrole nie mogły ustalić wyniku. Przejrzyj niepełne dowody poniżej i ponów te kontrole przed wyborem naprawy.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Location_Title">Lokalizacja</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Location_Impact">Sprawdź dostęp do lokalizacji i dostępność funkcji Znajdź moje urządzenie.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Sensors_Title">Czujniki</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Sensors_Impact">Sprawdź dostęp do czujników oddzielnie od lokalizacji.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_DiagnosticData_Title">Dane diagnostyczne</sys:String>
  <sys:String x:Key="Str_PrivacyArea_DiagnosticData_Impact">Oddzielnie sprawdź zbieranie danych diagnostycznych, raportowanie błędów i usługi zgodności. Obsługiwane poziomy zależą od wersji Windows i zasad.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Advertising_Title">Reklamy i sugestie</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Advertising_Impact">Sprawdź identyfikator reklamowy, dostosowane środowisko i sugerowane treści.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Camera_Title">Kamera</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Camera_Impact">Ograniczenie dostępu może uniemożliwić rozmowy wideo. Zachowaj wgląd w uprawnienia aplikacji i zarządzane zasady.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Microphone_Title">Mikrofon</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Microphone_Impact">Ograniczenie dostępu może uniemożliwić połączenia i nagrywanie. Zachowaj wgląd w uprawnienia aplikacji i zarządzane zasady.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ActivityHistory_Title">Historia aktywności</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ActivityHistory_Impact">Oddzielnie sprawdź rejestrowanie, publikowanie i przesyłanie aktywności.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_AppActivity_Title">Aktywność aplikacji</sys:String>
  <sys:String x:Key="Str_PrivacyArea_AppActivity_Impact">Sprawdź lokalne śledzenie uruchamiania aplikacji oddzielnie od historii aktywności w chmurze.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_InputPersonalization_Title">Pisanie i pismo odręczne</sys:String>
  <sys:String x:Key="Str_PrivacyArea_InputPersonalization_Impact">Sprawdź personalizację wprowadzania i zasady niejawnego zbierania danych pisania oraz pisma odręcznego.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ClipboardHistory_Title">Historia schowka</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ClipboardHistory_Impact">Ograniczenie historii wpływa na dostęp do wcześniej skopiowanych elementów.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ClipboardSync_Title">Synchronizacja schowka</sys:String>
  <sys:String x:Key="Str_PrivacyArea_ClipboardSync_Impact">Ograniczenie synchronizacji wpływa na kopiowanie między urządzeniami. Historia lokalna jest oddzielnym wyborem.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Feedback_Title">Prośby o opinię</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Feedback_Impact">Sprawdź powiadomienia z prośbą o opinię bez zmieniania usług diagnostycznych.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Spotlight_Title">Spotlight</sys:String>
  <sys:String x:Key="Str_PrivacyArea_Spotlight_Impact">Sprawdź zmieniające się treści i sugestie Windows.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_DeliveryOptimization_Title">Udostępnianie aktualizacji</sys:String>
  <sys:String x:Key="Str_PrivacyArea_DeliveryOptimization_Impact">Sprawdź ustawienia pobierania i wysyłania między urządzeniami. Usuwanie pamięci podręcznej to oddzielna operacja czyszczenia.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_OnlineSpeech_Title">Mowa online</sys:String>
  <sys:String x:Key="Str_PrivacyArea_OnlineSpeech_Impact">Ograniczenie rozpoznawania mowy w chmurze może wpłynąć na dyktowanie.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_WebSearch_Title">Wyszukiwanie w sieci</sys:String>
  <sys:String x:Key="Str_PrivacyArea_WebSearch_Impact">Sprawdź wyniki online niezależnie od wyszukiwania lokalnego.</sys:String>
  <sys:String x:Key="Str_PrivacyArea_NetworkDiscovery_Title">Prywatność sieci</sys:String>
  <sys:String x:Key="Str_PrivacyArea_NetworkDiscovery_Impact">Oddzielnie sprawdź sondy łączności, LLMNR i działanie sieci bezprzewodowej, ponieważ mogą od nich zależeć aplikacje i rozpoznawanie nazw.</sys:String>
  <sys:String x:Key="Str_PrivacySetting_advertising_id_Title">Identyfikator reklamowy</sys:String>
  <sys:String x:Key="Str_PrivacySetting_tailored_experiences_Title">Dostosowane środowisko</sys:String>
  <sys:String x:Key="Str_PrivacySetting_online_speech_Title">Rozpoznawanie mowy online</sys:String>
  <sys:String x:Key="Str_PrivacySetting_clipboard_sync_Title">Synchronizacja schowka</sys:String>
  <sys:String x:Key="Str_PrivacySetting_app_launch_tracking_Title">Śledzenie uruchamiania aplikacji</sys:String>
  <sys:String x:Key="Str_PrivacySetting_windows_tips_Title">Porady systemu Windows</sys:String>
  <sys:String x:Key="Str_PrivacySetting_suggested_notifications_Title">Sugerowane powiadomienia</sys:String>
  <sys:String x:Key="Str_PrivacySetting_consumer_content_Title">Treści konsumenckie</sys:String>
  <sys:String x:Key="Str_PrivacySetting_lock_screen_spotlight_Title">Spotlight na ekranie blokady</sys:String>
