  <sys:String x:Key="Str_Task_TimeZone">Strefa czasowa kalendarza</sys:String>
  <sys:String x:Key="Str_Task_SelectWeekdays">Wybierz dni tygodnia (Ctrl-klik, aby wybrać wiele)</sys:String>
