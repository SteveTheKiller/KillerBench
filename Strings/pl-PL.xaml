  <sys:String x:Key="Str_ScanUpdate">Skanuj Windows Update</sys:String>
  <sys:String x:Key="Str_ScanUpdateTip">Odczytuje CBS, Panther i ostatnie zdarzenia. Bez napraw. Esc zatrzymuje zbieranie.</sys:String>
