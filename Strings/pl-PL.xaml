  <sys:String x:Key="Str_Task_OverlapStop">Zatrzymaj poprzednie uruchomienie</sys:String>
  <sys:String x:Key="Str_Task_ReviewDraft">Przejrzyj szkic</sys:String>
  <sys:String x:Key="Str_Task_InspectDraft">Sprawdź szkic na tym komputerze</sys:String>
  <sys:String x:Key="Str_Task_InspectDraftTip">Odczytaj tożsamość pliku wykonywalnego i widoczne konflikty zadań bez rejestrowania ani uruchamiania czegokolwiek</sys:String>
