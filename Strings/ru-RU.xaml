  <sys:String x:Key="Str_Update_AllowFeatureUpgrade">Разрешить одно предложенное обновление компонентов Windows</sys:String>
  <sys:String x:Key="Str_Update_InstallConsent">Установить выбранные обновления Windows на этот компьютер</sys:String>
