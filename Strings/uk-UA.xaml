  <sys:String x:Key="Str_Task_UserAccount">Обліковий запис користувача (System використовує S-1-5-18)</sys:String>
  <sys:String x:Key="Str_Task_Highest">Найвищі привілеї</sys:String>
  <sys:String x:Key="Str_Task_ExecutionLimit">Ліміт виконання (хвилини, від 1 до 4320)</sys:String>
  <sys:String x:Key="Str_Task_Overlap">Якщо попередній запуск ще активний</sys:String>
  <sys:String x:Key="Str_Task_OverlapSkip">Пропустити новий запуск</sys:String>
