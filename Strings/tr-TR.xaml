  <sys:String x:Key="Str_Time_DomainHierarchy">Etki alanı hiyerarşisi</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Özel NTP eşleri</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Boşlukla ayrılmış en fazla sekiz NTP ana bilgisayar adı veya IP adresi</sys:String>
  <sys:String x:Key="Str_Time_Apply">Seçili kaynağı uygula ve eşitle (saati değiştirebilir)</sys:String>
