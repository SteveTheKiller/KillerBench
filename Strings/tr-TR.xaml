  <sys:String x:Key="Str_Print_FindPrinters">Yerel yazıcıları bul</sys:String>
  <sys:String x:Key="Str_Print_RepairDefault">Eksik veya çakışan varsayılanı bu kuyrukla onar</sys:String>
