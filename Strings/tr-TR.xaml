  <sys:String x:Key="Str_Mace_RemoveCredentials">Seçili uygulamaların önbelleğe alınmış kimlik bilgilerini kaldır</sys:String>
  <sys:String x:Key="Str_Mace_RestoreFolders">Geri yükleme için OneDrive klasör konumlarını incele</sys:String>
  <sys:String x:Key="Str_Mace_ReviewBoundary">GO bu seçimleri yalnızca bir incelemede kaydeder. Hiçbir işlem, uygulama, paket, dosya, kimlik bilgisi, klasör konumu, kayıt defteri değeri veya kullanıcı verisi değişmez.</sys:String>
  <sys:String x:Key="Str_Mace_PackagePlan">Desteklenen paket planı</sys:String>
  <sys:String x:Key="Str_Mace_CheckPackage">Seçili paketi denetle</sys:String>
  <sys:String x:Key="Str_Mace_PackageHint">Desteklenen geçerli hesap paketi adaylarını bulmak için GO çalıştırın.</sys:String>
  <sys:String x:Key="Str_Mace_DestructiveRemoval">Yıkıcı paket kaldırma</sys:String>
  <sys:String x:Key="Str_Mace_RemovalConsent">Bunun yalnızca güncel korumalar geçtikten sonra seçili paketi kaldırdığını anlıyorum</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackage">SEÇİLİ PAKETİ KALDIR</sys:String>
  <sys:String x:Key="Str_Mace_RemovePackageTip">Kaldırma istemeden önce uygun bir inceleme, bu onay, ikinci bir onay ve güncel tam kanıt gerektirir.</sys:String>
  <sys:String x:Key="Str_Mace_CheckInterrupted">Kesintiye uğrayan kaldırmayı denetle</sys:String>
