  <sys:String x:Key="Str_Apps_ReviewExtensions">Tarayıcı uzantılarını incele</sys:String>
  <sys:String x:Key="Str_Apps_ReviewExtensionsTip">Chrome, Edge, Brave ve Firefox uzantı kimliklerini okur. Hiçbir tarayıcı, uzantı veya ilke değiştirilmez.</sys:String>
