  <sys:String x:Key="Str_Time_DomainHierarchy">Hierarquia de domínio</sys:String>
  <sys:String x:Key="Str_Time_CustomPeers">Pares NTP personalizados</sys:String>
  <sys:String x:Key="Str_Time_PeersTip">Até oito nomes de host ou endereços IP NTP, separados por espaços</sys:String>
  <sys:String x:Key="Str_Time_Apply">Aplicar a origem selecionada e sincronizar (pode alterar o relógio)</sys:String>
  <sys:String x:Key="Str_Time_CheckInterrupted">Verificar alteração de hora interrompida</sys:String>
  <sys:String x:Key="Str_Time_CheckInterruptedTip">Verificar as configurações registradas sem tentar a alteração novamente</sys:String>
  <sys:String x:Key="Str_Time_Boundary">GO mostra uma prévia das alterações de origem, a menos que Aplicar esteja selecionado. A hierarquia de domínio se limita a um membro de domínio que não seja controlador de domínio. Toda alteração exige novas verificações de política, função e elevação. Sem reversão automática.</sys:String>
  <sys:String x:Key="Str_Profile_MinimumAge">Mínimo de dias desde o último uso (somente revisão):</sys:String>
  <sys:String x:Key="Str_Profile_CheckDependencies">Verificar dependências de serviços e tarefas agendadas</sys:String>
  <sys:String x:Key="Str_Profile_SelectAfterReview">Selecionar perfis após a revisão</sys:String>
  <sys:String x:Key="Str_Profile_PreviewSelected">Visualizar os perfis selecionados</sys:String>
  <sys:String x:Key="Str_Profile_BackupHeader">Fazer backup e verificar um perfil</sys:String>
  <sys:String x:Key="Str_Profile_BackupDescription">Selecione exatamente um perfil revisado. Para criar um novo backup, digite uma nova pasta NTFS local que não exista. Para inspecionar uma cópia existente, escolha a pasta dela. O KillerBench nunca exclui o perfil.</sys:String>
  <sys:String x:Key="Str_Profile_Browse">Procurar</sys:String>
  <sys:String x:Key="Str_Profile_BackupPathTip">Uma nova pasta NTFS local inexistente para a cópia, ou uma pasta de perfil copiada existente para verificação</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerify">Copiar e verificar</sys:String>
  <sys:String x:Key="Str_Profile_CopyVerifyTip">Copia o perfil descarregado selecionado uma vez para uma nova pasta NTFS local vazia e depois verifica cada arquivo regular</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerification">Criar arquivos de verificação</sys:String>
  <sys:String x:Key="Str_Profile_CreateVerificationTip">Compara o perfil ativo selecionado com a pasta copiada existente e depois cria o manifesto e o recibo</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackup">Verificar backup copiado</sys:String>
  <sys:String x:Key="Str_Profile_VerifyBackupTip">Verifica o manifesto e o recibo existentes em relação ao perfil ativo e à pasta copiada</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterrupted">Verificar backup interrompido</sys:String>
  <sys:String x:Key="Str_Profile_CheckInterruptedTip">Verifica um backup pendente sem copiar os arquivos novamente</sys:String>
  <sys:String x:Key="Str_Profile_VerificationBoundary">A verificação compara o conjunto completo de arquivos regulares, os tamanhos e os hashes SHA-256. Ela não comprova permissões, fluxos alternativos, arquivos criptografados, estado de aplicativos nem o comportamento da restauração.</sys:String>
  <sys:String x:Key="Str_Privacy_Description">Escolha as áreas a inspecionar. Controles protegidos separados estão disponíveis para a Área de Transferência e as configurações de conta compatíveis, incluindo o acesso à câmera e ao microfone.</sys:String>
  <sys:String x:Key="Str_Privacy_ClipboardHistory">Histórico da área de transferência</sys:String>
  <sys:String x:Key="Str_Privacy_InspectOnly">Somente inspecionar</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOn">Ativar</sys:String>
  <sys:String x:Key="Str_Privacy_TurnOff">Desativar</sys:String>
  <sys:String x:Key="Str_Privacy_Apply">Aplicar quando eu pressionar GO</sys:String>
  <sys:String x:Key="Str_Shell_Tools">Ferramentas</sys:String>
  <sys:String x:Key="Str_Privacy_Setting">Configuração de privacidade</sys:String>
  <sys:String x:Key="Str_Privacy_Action">Ação</sys:String>
  <sys:String x:Key="Str_Privacy_Boundary">Aplicar altera somente esta conta. Políticas correspondentes, acesso a dispositivos em todo o computador, exceções por aplicativo, coleta de diagnósticos e o conteúdo armazenado da área de transferência são preservados. Diários verificados permitem desfazer com proteção.</sys:String>
  <sys:String x:Key="Str_BitLocker_Description">GO inspeciona por padrão. Backup, criptografia e retomada da proteção exigem, cada um, a confirmação correspondente abaixo.</sys:String>
  <sys:String x:Key="Str_BitLocker_Volume">Volume</sys:String>
  <sys:String x:Key="Str_BitLocker_Operation">Operação</sys:String>
  <sys:String x:Key="Str_BitLocker_Encryption">Criptografia</sys:String>
  <sys:String x:Key="Str_BitLocker_RecoveryBackup">Backup de recuperação</sys:String>
  <sys:String x:Key="Str_BitLocker_UsedSpace">Somente espaço usado</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupFile">Arquivo de backup (para destino de Arquivo)</sys:String>
  <sys:String x:Key="Str_BitLocker_Browse">Procurar...</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupPathTip">Para backup em arquivo, informe um caminho completo fora do volume protegido.</sys:String>
  <sys:String x:Key="Str_BitLocker_FindProtectors">Localizar protetores de recuperação</sys:String>
  <sys:String x:Key="Str_BitLocker_BackupConsent">Gravar o backup de recuperação selecionado quando eu pressionar GO</sys:String>
  <sys:String x:Key="Str_BitLocker_EncryptConsent">Fazer backup da chave de recuperação selecionada e depois iniciar a criptografia quando eu pressionar GO</sys:String>
  <sys:String x:Key="Str_BitLocker_ResumeConsent">Retomar a proteção neste volume totalmente criptografado quando eu pressionar GO</sys:String>
  <sys:String x:Key="Str_BitLocker_Boundary">A criptografia exige o protetor de senha de recuperação selecionado e um novo arquivo de backup verificado fora do volume protegido. A unidade do Windows também precisa do protetor TPM. Protetores existentes e a política gerenciada são preservados.</sys:String>
  <sys:String x:Key="Str_BitLocker_MoreActions">Mais ações do BitLocker</sys:String>
  <sys:String x:Key="Str_BitLocker_Action">Ação</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAutoUnlock">Ativar o desbloqueio automático</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddTpm">Adicionar um protetor TPM</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionAddRecovery">Adicionar uma senha de recuperação</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowAd">Fazer backup da senha de recuperação no Active Directory</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionEscrowEntra">Fazer backup da senha de recuperação no Microsoft Entra ID</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionDecrypt">Descriptografar esta unidade</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionHint">Os backups usam o protetor de recuperação escolhido acima. Cada ação repete suas verificações imediatamente antes de ser executada e nunca repete uma solicitação interrompida.</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionConsent">Fazer esta alteração na unidade selecionada quando eu pressionar Executar ação</sys:String>
  <sys:String x:Key="Str_BitLocker_DecryptConsent">Entendo que a unidade ficará desprotegida</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionPreview">Visualizar</sys:String>
  <sys:String x:Key="Str_BitLocker_ActionRun">Executar ação</sys:String>
  <sys:String x:Key="Str_EventLog_Channel">Canal de diagnóstico</sys:String>
  <sys:String x:Key="Str_EventLog_System">Sistema</sys:String>
  <sys:String x:Key="Str_EventLog_Application">Aplicativo</sys:String>
  <sys:String x:Key="Str_EventLog_Setup">Instalação</sys:String>
  <sys:String x:Key="Str_EventLog_WindowsUpdate">Windows Update Client / Operational</sys:String>
  <sys:String x:Key="Str_EventLog_Enable">Ativar este canal após novas verificações</sys:String>
  <sys:String x:Key="Str_EventLog_Boundary">GO sempre inspeciona os quatro canais. Esta opção altera somente o canal exato selecionado que esteja desativado e não gerenciado, e verifica se todas as outras configurações de canal informadas permaneceram inalteradas.</sys:String>
  <sys:String x:Key="Str_Network_Hostname">Pesquisa de nome de host (opcional)</sys:String>
  <sys:String x:Key="Str_Network_Destination">Destino TCP (opcional)</sys:String>
  <sys:String x:Key="Str_Network_Port">Porta TCP</sys:String>
  <sys:String x:Key="Str_Network_Timeout">Tempo limite por consulta ou conexão (segundos)</sys:String>
  <sys:String x:Key="Str_Network_ConnectionBoundary">Informe o destino e a porta para testar uma conexão. Nenhum dado de aplicativo é enviado.</sys:String>
  <sys:String x:Key="Str_Network_DnsBoundary">Deixe em branco para ignorar. Usa o resolvedor configurado; nenhuma configuração de DNS é alterada.</sys:String>
  <sys:String x:Key="Str_Audio_EndpointScope">Escopo do ponto de extremidade padrão</sys:String>
  <sys:String x:Key="Str_Audio_InputOutput">Entrada e saída</sys:String>
  <sys:String x:Key="Str_Audio_Output">Saída</sys:String>
  <sys:String x:Key="Str_Audio_Input">Entrada</sys:String>
  <sys:String x:Key="Str_Audio_WindowsRole">Função do Windows</sys:String>
  <sys:String x:Key="Str_Audio_AllRoles">Todas as funções</sys:String>
  <sys:String x:Key="Str_Audio_Console">Console</sys:String>
  <sys:String x:Key="Str_Audio_Multimedia">Multimídia</sys:String>
  <sys:String x:Key="Str_Audio_Communications">Comunicações</sys:String>
  <sys:String x:Key="Str_Audio_Boundary">GO ainda verifica todos os dispositivos e drivers de áudio. Estes controles limitam os detalhes exibidos do ponto de extremidade padrão.</sys:String>
  <sys:String x:Key="Str_Restore_Prepare">Preparar um ponto de restauração</sys:String>
  <sys:String x:Key="Str_Restore_Description">Descrição</sys:String>
  <sys:String x:Key="Str_Restore_DefaultDescription">Antes da manutenção do KillerBench</sys:String>
  <sys:String x:Key="Str_Restore_Reason">Motivo</sys:String>
  <sys:String x:Key="Str_Restore_SystemSettings">Alteração das configurações do sistema</sys:String>
  <sys:String x:Key="Str_Restore_ApplicationInstall">Instalação de aplicativo</sys:String>
  <sys:String x:Key="Str_Restore_DriverInstall">Instalação de driver de dispositivo</sys:String>
  <sys:String x:Key="Str_Restore_Boundary">GO lista os pontos existentes, a menos que esta opção esteja selecionada. Selecione a ação automática abaixo para solicitar um ponto após novas verificações. Os limites de frequência do Windows e a política de proteção são preservados.</sys:String>
  <sys:String x:Key="Str_Storage_Volume">Volume a verificar</sys:String>
  <sys:String x:Key="Str_Storage_Description">Verifica este volume NTFS e os dispositivos de disco e controladora em todo o PC. As descobertas de dispositivos não são associadas a este volume. Nenhum reparo ou reinicialização é agendado.</sys:String>
  <sys:String x:Key="Str_Storage_RepairReview">Revisar reparo do sistema de arquivos</sys:String>
  <sys:String x:Key="Str_Storage_SpotRepair">Reparo pontual</sys:String>
  <sys:String x:Key="Str_Storage_OfflineRepair">Verificação e reparo offline</sys:String>
  <sys:String x:Key="Str_Storage_AllowDismount">Permitir que um volume que não seja do sistema fique offline</sys:String>
  <sys:String x:Key="Str_Storage_BackupConfirmed">Os dados importantes deste volume têm backup</sys:String>
  <sys:String x:Key="Str_Storage_OptimizationReview">Analisar a otimização da unidade</sys:String>
  <sys:String x:Key="Str_Storage_WindowsRecommended">Recomendado pelo Windows</sys:String>
  <sys:String x:Key="Str_Storage_Retrim">Executar Retrim no armazenamento de estado sólido</sys:String>
  <sys:String x:Key="Str_Storage_Defragment">Desfragmentar o disco rígido</sys:String>
  <sys:String x:Key="Str_Storage_Boundary">GO sempre coleta primeiro as evidências atuais. O reparo do sistema de arquivos e a otimização da unidade são escolhas separadas. A otimização exige um tipo de mídia confirmado e nunca altera agendamentos nem reinicia o Windows.</sys:String>
  <sys:String x:Key="Str_ComponentCleanup_Boundary">GO verifica se o Windows recomenda a limpeza. A limpeza opcional remove imediatamente componentes substituídos; sem desfazer nem reinicialização automática. O espaço recuperado não é medido.</sys:String>
  <sys:String x:Key="Str_FileReview_Header">Revisar a pasta selecionada</sys:String>
  <sys:String x:Key="Str_FileReview_Description">Encontre arquivos duplicados ou grandes em uma pasta local selecionada. As duas revisões são somente leitura e nunca selecionam arquivos para exclusão.</sys:String>
  <sys:String x:Key="Str_FileReview_Browse">Procurar</sys:String>
  <sys:String x:Key="Str_FileReview_FolderTip">Uma pasta local. Pontos de nova análise e conteúdo inacessível são excluídos.</sys:String>
  <sys:String x:Key="Str_FileReview_Duplicates">Localizar duplicados</sys:String>
  <sys:String x:Key="Str_FileReview_DuplicatesTip">Revisão de duplicados SHA-256 somente leitura</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFiles">Localizar arquivos grandes</sys:String>
  <sys:String x:Key="Str_FileReview_LargeFilesTip">Revisão somente leitura de arquivos de pelo menos 100 MB</sys:String>
  <sys:String x:Key="Str_ComputerName_Proposed">Nome de computador proposto</sys:String>
  <sys:String x:Key="Str_ComputerName_Rename">Renomear este PC de grupo de trabalho após novas verificações</sys:String>
  <sys:String x:Key="Str_ComputerName_Boundary">GO revisa o nome e a identidade atual. Com a opção de renomear selecionada, somente um PC autônomo de grupo de trabalho com pré-requisitos claros é elegível. O KillerBench nunca reinicia o Windows.</sys:String>
  <sys:String x:Key="Str_Main_AutoRepair">Reparar automaticamente os problemas confirmados</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosis">Executar diagnóstico</sys:String>
  <sys:String x:Key="Str_Main_RunDiagnosisTip">Executa as verificações somente leitura selecionadas e abre um relatório legível.</sys:String>
  <sys:String x:Key="Str_Main_Stop">Parar</sys:String>
  <sys:String x:Key="Str_Main_StopTip">Parar após o comando atual (Esc)</sys:String>
  <sys:String x:Key="Str_Task_NewDraft">Novo rascunho de tarefa</sys:String>
  <sys:String x:Key="Str_Task_Folder">Pasta de tarefas</sys:String>
  <sys:String x:Key="Str_Task_Name">Nome da tarefa</sys:String>
  <sys:String x:Key="Str_Task_Executable">Caminho do executável</sys:String>
  <sys:String x:Key="Str_Task_Arguments">Argumentos</sys:String>
  <sys:String x:Key="Str_Task_WorkingDirectory">Diretório de trabalho (opcional)</sys:String>
  <sys:String x:Key="Str_Task_Schedule">Agendamento</sys:String>
  <sys:String x:Key="Str_Task_Daily">Diário</sys:String>
  <sys:String x:Key="Str_Task_Weekly">Semanal</sys:String>
  <sys:String x:Key="Str_Task_Monthly">Mensal</sys:String>
  <sys:String x:Key="Str_Task_Startup">Inicialização</sys:String>
  <sys:String x:Key="Str_Task_Time">Hora (HH:mm, não usada na inicialização)</sys:String>
  <sys:String x:Key="Str_Task_TimeZone">Fuso horário do calendário</sys:String>
  <sys:String x:Key="Str_Task_SelectWeekdays">Selecione os dias da semana (Ctrl+clique para vários)</sys:String>
  <sys:String x:Key="Str_Task_SelectMonthDays">Selecione os dias do mês (Ctrl+clique para vários)</sys:String>
  <sys:String x:Key="Str_Task_LastDay">Último dia em vez dos dias selecionados</sys:String>
  <sys:String x:Key="Str_Task_AccountMode">Modo de conta</sys:String>
  <sys:String x:Key="Str_Task_InteractiveUser">Usuário interativo</sys:String>
  <sys:String x:Key="Str_Task_LocalSystem">Sistema Local</sys:String>
  <sys:String x:Key="Str_Task_UserAccount">Conta de usuário (Sistema usa S-1-5-18)</sys:String>
  <sys:String x:Key="Str_Task_Highest">Privilégios mais altos</sys:String>
  <sys:String x:Key="Str_Task_ExecutionLimit">Limite de execução (minutos, de 1 a 4320)</sys:String>
  <sys:String x:Key="Str_Task_Overlap">Se uma execução anterior ainda estiver ativa</sys:String>
  <sys:String x:Key="Str_Task_OverlapSkip">Ignorar a nova execução</sys:String>
  <sys:String x:Key="Str_Task_OverlapQueue">Enfileirar a nova execução</sys:String>
  <sys:String x:Key="Str_Task_OverlapParallel">Executar ambas ao mesmo tempo</sys:String>
  <sys:String x:Key="Str_Task_OverlapStop">Interromper a execução anterior</sys:String>
  <sys:String x:Key="Str_Task_ReviewDraft">Revisar rascunho</sys:String>
  <sys:String x:Key="Str_Task_InspectDraft">Inspecionar o rascunho neste PC</sys:String>
  <sys:String x:Key="Str_Task_InspectDraftTip">Lê a identidade do executável e os conflitos visíveis de tarefas sem registrar nem executar nada</sys:String>
  <sys:String x:Key="Str_Task_SaveDraft">Salvar novo rascunho...</sys:String>
  <sys:String x:Key="Str_Task_SaveDraftTip">Salva em um novo arquivo JSON; arquivos existentes são preservados</sys:String>
  <sys:String x:Key="Str_Task_StartDate">Data de início do XML (AAAA-MM-DD)</sys:String>
  <sys:String x:Key="Str_Task_StartDateTip">Limite inicial no calendário local; gatilhos de inicialização não usam esta data</sys:String>
  <sys:String x:Key="Str_Task_ExportXml">Exportar XML da tarefa desativada...</sys:String>
  <sys:String x:Key="Str_Task_ExportXmlTip">Exporta um novo arquivo de revisão usando o fuso horário do calendário local. Nenhuma tarefa é registrada nem executada; arquivos existentes são preservados</sys:String>
  <sys:String x:Key="Str_Task_RegisterConsent">Criar esta tarefa desativada do Sistema Local após novas verificações</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistration">Visualizar o registro</sys:String>
  <sys:String x:Key="Str_Task_PreviewRegistrationTip">Visualização por padrão. A criação exige a confirmação separada, elevação, um executável assinado válido, uma pasta existente e um destino exato inexistente.</sys:String>
  <sys:String x:Key="Str_Task_CheckInterrupted">Verificar registro interrompido</sys:String>
  <sys:String x:Key="Str_Task_CheckInterruptedTip">Lê a definição exata atual da tarefa e fecha uma proteção pendente correspondente. Nunca tenta novamente, ativa, executa, substitui nem exclui uma tarefa.</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlan">Revisar plano de tarefa salvo...</sys:String>
  <sys:String x:Key="Str_Task_ReviewSavedPlanTip">Abre um arquivo JSON de plano de tarefa somente para revisão</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecovery">Revisar registros de recuperação...</sys:String>
  <sys:String x:Key="Str_Task_ReviewRecoveryTip">Selecione um registro ou um par de intenção/conclusão. A revisão nunca altera uma tarefa nem permite uma nova tentativa.</sys:String>
  <sys:String x:Key="Str_Task_Boundary">GO faz o inventário das tarefas existentes. O registro é separado, cria apenas uma tarefa desativada e nunca executa, substitui nem exclui uma tarefa.</sys:String>
  <sys:String x:Key="Str_Cleanup_UserTemp">Arquivos temporários do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_WindowsTemp">Arquivos temporários do Windows</sys:String>
  <sys:String x:Key="Str_Cleanup_SystemTemp">Arquivos SystemTemp do Windows</sys:String>
  <sys:String x:Key="Str_Cleanup_SystemTempTip">Somente a pasta padrão SystemTemp do Windows. Arquivos recentes, protegidos e em uso são ignorados. Normalmente é exigido acesso de administrador.</sys:String>
  <sys:String x:Key="Str_Cleanup_ShaderCaches">Caches de shader do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_ShaderCachesTip">D3D, AMD DxCache e NVIDIA GLCache. Recriar os caches pode causar atrasos iniciais na renderização. Arquivos em uso e recentes são ignorados.</sys:String>
  <sys:String x:Key="Str_Cleanup_BrowserCaches">Caches de navegador do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_BrowserCachesTip">Pastas de cache padrão do Chrome, Edge, Brave, Firefox e Opera. Cookies, logins e favoritos estão fora desses alvos. Locais personalizados não são pesquisados.</sys:String>
  <sys:String x:Key="Str_Cleanup_OfficeCaches">Caches do Office do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_OfficeCachesTip">Somente as pastas padrão OfficeFileCache e OTele. Arquivos abertos ou recentes são ignorados. O Office pode recriar arquivos de cache após a limpeza.</sys:String>
  <sys:String x:Key="Str_Cleanup_ThumbnailCache">Cache de miniaturas do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_ThumbnailCacheTip">Somente arquivos de banco de dados de miniaturas do Windows. Histórico do Explorador de Arquivos, itens recentes e pesquisas salvas são excluídos. O Windows recria as miniaturas conforme as pastas são exibidas.</sys:String>
  <sys:String x:Key="Str_Cleanup_IconCache">Cache de ícones do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_IconCacheTip">Somente arquivos de banco de dados de ícones do Windows. Histórico do Explorador de Arquivos, itens recentes e pesquisas salvas são excluídos. O Windows recria os ícones conforme necessário.</sys:String>
  <sys:String x:Key="Str_Cleanup_ErrorReports">Relatórios de erros do Windows arquivados</sys:String>
  <sys:String x:Key="Str_Cleanup_ErrorReportsTip">Somente o arquivo e a fila do Relatório de Erros do Windows do usuário atual. Remover esses arquivos descarta evidências históricas locais de falhas.</sys:String>
  <sys:String x:Key="Str_Cleanup_CrashDumps">Despejos de falha de aplicativos</sys:String>
  <sys:String x:Key="Str_Cleanup_CrashDumpsTip">Somente a pasta CrashDumps do usuário atual. Remover os despejos descarta evidências de diagnóstico que podem ser necessárias para investigar falhas de aplicativos.</sys:String>
  <sys:String x:Key="Str_Cleanup_WindowsMinidumps">Minidespejos de falha do Windows</sys:String>
  <sys:String x:Key="Str_Cleanup_WindowsMinidumpsTip">Somente a pasta Minidump do Windows. Normalmente é exigido acesso de administrador. MEMORY.DMP é excluído. Remover os minidespejos descarta evidências de diagnóstico.</sys:String>
  <sys:String x:Key="Str_Cleanup_DeliveryOptimization">Cache da Otimização de Entrega</sys:String>
  <sys:String x:Key="Str_Cleanup_DeliveryOptimizationTip">Somente o cache padrão da Otimização de Entrega do Windows. Arquivos recentes, protegidos e em uso são ignorados. O conteúdo removido pode precisar ser baixado novamente.</sys:String>
  <sys:String x:Key="Str_Cleanup_RecycleBin">Lixeira do usuário atual</sys:String>
  <sys:String x:Key="Str_Cleanup_RecycleBinTip">Tudo ou nada em toda a Lixeira atual do shell do Windows. A configuração de idade não se aplica. A execução é bloqueada quando a contagem de itens informada excede o limite selecionado.</sys:String>
  <sys:String x:Key="Str_Cleanup_MinimumAge">Idade mínima (dias)</sys:String>
