  <sys:String x:Key="Str_Mace_DestructiveRemoval">Rimozione distruttiva pacchetto</sys:String>
  <sys:String x:Key="Str_Mace_RemovalConsent">Comprendo che questo rimuove solo il pacchetto selezionato dopo il superamento di controlli di sicurezza aggiornati</sys:String>
